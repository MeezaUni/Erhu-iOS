    "Open Erhu to play music.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Erhu لتشغيل الموسيقى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গান চালাতে Erhu খুলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Erhu, um Musik abzuspielen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Erhu para reproducir música."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای پخش موسیقی Erhu را باز کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang Erhu para magpatugtog ng musika."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Erhu pour écouter de la musique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संगीत चलाने के लिए Erhu खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Erhu untuk memutar musik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Erhu per ascoltare musica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhuを開いて音楽を再生してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악을 재생하려면 Erhu를 여세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Erhu om muziek af te spelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Erhu, aby odtworzyć muzykę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Erhu para ouvir música."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Erhu, чтобы включить музыку."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இசையை இயக்க Erhu ஐத் திறக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సంగీతం ప్లే చేయడానికి Erhu ను తెరవండి."
          }
        },
