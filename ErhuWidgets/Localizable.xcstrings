          "stringUnit": {
            "state": "translated",
            "value": "Müzik çalmak için Erhu’yu aç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Erhu, щоб увімкнути музику."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موسیقی چلانے کے لیے Erhu کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Erhu để phát nhạc."
          }
        },
