    "Reinstall Erhu with your installer to use this widget.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد تثبيت Erhu باستخدام أداة التثبيت لاستخدام هذه الأداة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই উইজেট ব্যবহার করতে আপনার ইনস্টলার দিয়ে Erhu আবার ইনস্টল করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere Erhu mit deinem Installer neu, um dieses Widget zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a instalar Erhu con tu instalador para usar este widget."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای استفاده از این ابزارک، Erhu را با نصب‌کنندهٔ خود دوباره نصب کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-install muli ang Erhu gamit ang iyong installer para magamit ang widget na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinstallez Erhu avec votre installateur pour utiliser ce widget."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह विजेट इस्तेमाल करने के लिए अपने इंस्टॉलर से Erhu दोबारा इंस्टॉल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Instal ulang Erhu dengan penginstal Anda untuk memakai widget ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinstalla Erhu con il tuo installer per usare questo widget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウィジェットを使うには、インストーラでErhuを再インストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 위젯을 사용하려면 설치 앱으로 Erhu를 다시 설치하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer Erhu opnieuw met je installer om deze widget te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstaluj Erhu ponownie swoim instalatorem, aby używać tego widżetu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinstale o Erhu com seu instalador para usar este widget."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переустановите Erhu через свой установщик, чтобы пользоваться виджетом."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த விட்ஜெட்டைப் பயன்படுத்த உங்கள் நிறுவியால் Erhu ஐ மீண்டும் நிறுவவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ విడ్జెట్‌ను ఉపయోగించడానికి మీ ఇన్‌స్టాలర్‌తో Erhu ను మళ్ళీ ఇన్‌స్టాల్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้ง Erhu ใหม่ด้วยตัวติดตั้งของคุณเพื่อใช้วิดเจ็ตนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu widget’ı kullanmak için Erhu’yu yükleyicinle yeniden yükle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевстановіть Erhu своїм інсталятором, щоб користуватися віджетом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ویجیٹ استعمال کرنے کے لیے اپنے انسٹالر سے Erhu دوبارہ انسٹال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài lại Erhu bằng trình cài đặt của bạn để dùng tiện ích này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请用你的安装工具重新安装 Erhu 以使用此小组件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請用你的安裝工具重新安裝 Erhu 以使用此小工具。"
          }
        }
      }
    },
    "See what's playing and control playback.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرف ما يُشغّل الآن وتحكّم في التشغيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী বাজছে দেখুন এবং প্লেব্যাক নিয়ন্ত্রণ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, was läuft, und steuere die Wiedergabe."
          }
        },
        "es": {
