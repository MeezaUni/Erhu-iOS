{
  "sourceLanguage" : "en",
  "strings" : {
    "NSLocalNetworkUsageDescription" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Erhu شبكتك الخاصة للنقل عبر Wi-Fi، الذي يستقبل الموسيقى من متصفح حاسوبك، وللوصول إلى Erhu Server على حاسوبك أو جهاز NAS. لا يمر أي شيء عبر خدمة من Erhu."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu আপনার নিজের নেটওয়ার্ক ব্যবহার করে ওয়াই-ফাই ট্রান্সফারের জন্য, যা কম্পিউটারের ব্রাউজার থেকে গান গ্রহণ করে, এবং আপনার কম্পিউটার বা NAS-এ থাকা Erhu Server-এ পৌঁছাতে। কিছুই Erhu-এর কোনো পরিষেবার মধ্য দিয়ে যায় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu nutzt dein eigenes Netzwerk für die WLAN-Übertragung, die Musik aus dem Browser deines Computers empfängt, und um Erhu Server auf deinem Computer oder NAS zu erreichen. Nichts läuft über einen Erhu-Dienst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu usa tu propia red para la transferencia por Wi-Fi, que recibe música desde el navegador de tu ordenador, y para conectar con Erhu Server en tu ordenador o NAS. Nada pasa por un servicio de Erhu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu از شبکهٔ خودتان برای انتقال با Wi-Fi، که موسیقی را از مرورگر رایانه دریافت می‌کند، و برای دسترسی به Erhu Server روی رایانه یا NAS شما استفاده می‌کند. هیچ چیز از سرویسی از Erhu عبور نمی‌کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ginagamit ng Erhu ang sarili mong network para sa Wi-Fi Transfer, na tumatanggap ng musika mula sa browser ng iyong computer, at para maabot ang Erhu Server sa iyong computer o NAS. Walang dumadaan sa anumang serbisyo ng Erhu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu utilise votre propre réseau pour le transfert Wi-Fi, qui reçoit la musique depuis le navigateur de votre ordinateur, et pour joindre Erhu Server sur votre ordinateur ou votre NAS. Rien ne passe par un service Erhu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu आपके अपने नेटवर्क का उपयोग Wi-Fi ट्रांसफ़र के लिए करता है, जो आपके कंप्यूटर के ब्राउज़र से संगीत प्राप्त करता है, और आपके कंप्यूटर या NAS पर Erhu Server तक पहुँचने के लिए। कुछ भी Erhu की किसी सेवा से होकर नहीं जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu memakai jaringan Anda sendiri untuk Transfer Wi-Fi, yang menerima musik dari browser komputer Anda, dan untuk menjangkau Erhu Server di komputer atau NAS Anda. Tidak ada yang melewati layanan Erhu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu usa la tua rete per il trasferimento Wi-Fi, che riceve musica dal browser del computer, e per raggiungere Erhu Server sul tuo computer o NAS. Nulla passa da un servizio di Erhu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhuは、コンピュータのブラウザから音楽を受け取るWi-Fi転送と、コンピュータやNAS上のErhu Serverへの接続に、あなた自身のネットワークを使用します。Erhuのサービスを経由するものはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu는 컴퓨터 브라우저에서 음악을 받는 Wi-Fi 전송과, 컴퓨터나 NAS의 Erhu Server에 연결하기 위해 사용자의 네트워크를 사용합니다. Erhu 서비스를 거치는 것은 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu gebruikt je eigen netwerk voor Wi-Fi-overdracht, die muziek ontvangt vanuit de browser van je computer, en om Erhu Server op je computer of NAS te bereiken. Niets gaat via een dienst van Erhu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu korzysta z Twojej sieci do przesyłania przez Wi-Fi, które odbiera muzykę z przeglądarki na komputerze, oraz do łączenia się z Erhu Server na Twoim komputerze lub serwerze NAS. Nic nie przechodzi przez usługę Erhu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Erhu usa sua própria rede para a transferência por Wi-Fi, que recebe músicas do navegador do computador, e para acessar o Erhu Server no seu computador ou NAS. Nada passa por um serviço do Erhu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu использует вашу собственную сеть для передачи по Wi-Fi, которая принимает музыку из браузера компьютера, и для подключения к Erhu Server на вашем компьютере или NAS. Ничего не проходит через сервисы Erhu."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் கணினியின் உலாவியிலிருந்து இசையைப் பெறும் Wi-Fi பரிமாற்றத்திற்கும், உங்கள் கணினி அல்லது NAS-இல் உள்ள Erhu Server-ஐ அடையவும் Erhu உங்கள் சொந்த நெட்வொர்க்கைப் பயன்படுத்துகிறது. எதுவும் Erhu சேவை வழியாகச் செல்லாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ కంప్యూటర్ బ్రౌజర్ నుండి సంగీతాన్ని స్వీకరించే Wi-Fi బదిలీ కోసం, మీ కంప్యూటర్ లేదా NAS లోని Erhu Serverను చేరుకోవడానికి Erhu మీ స్వంత నెట్‌వర్క్‌ను ఉపయోగిస్తుంది. ఏదీ Erhu సేవ ద్వారా వెళ్లదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu ใช้เครือข่ายของคุณเองสำหรับการโอนผ่าน Wi-Fi ซึ่งรับเพลงจากเบราว์เซอร์ในคอมพิวเตอร์ และเพื่อเชื่อมต่อ Erhu Server บนคอมพิวเตอร์หรือ NAS ของคุณ ไม่มีสิ่งใดผ่านบริการของ Erhu"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu, bilgisayarınızın tarayıcısından müzik alan Wi-Fi Aktarımı ve bilgisayarınızdaki ya da NAS’ınızdaki Erhu Server’a ulaşmak için kendi ağınızı kullanır. Hiçbir şey bir Erhu hizmetinden geçmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu використовує вашу власну мережу для передавання через Wi-Fi, яке отримує музику з браузера комп’ютера, і для з’єднання з Erhu Server на вашому комп’ютері чи NAS. Ніщо не проходить через сервіси Erhu."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu آپ کا اپنا نیٹ ورک Wi-Fi ٹرانسفر کے لیے استعمال کرتا ہے، جو آپ کے کمپیوٹر کے براؤزر سے موسیقی وصول کرتا ہے، اور آپ کے کمپیوٹر یا NAS پر Erhu Server تک پہنچنے کے لیے۔ کچھ بھی Erhu کی کسی سروس سے نہیں گزرتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu dùng mạng của chính bạn cho Truyền qua Wi-Fi, vốn nhận nhạc từ trình duyệt trên máy tính, và để kết nối Erhu Server trên máy tính hoặc NAS của bạn. Không có gì đi qua dịch vụ của Erhu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu 使用你自己的网络进行无线局域网传输（从电脑浏览器接收音乐），并连接你电脑或 NAS 上的 Erhu Server。不会经过任何 Erhu 服务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu 使用你自己的網路進行 Wi-Fi 傳輸（從電腦瀏覽器接收音樂），並連線你電腦或 NAS 上的 Erhu Server。不會經過任何 Erhu 服務。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ Erhu بطاقات الإحصاءات التي تصنعها في صورك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার তৈরি পরিসংখ্যান কার্ড Erhu আপনার ফটোতে সংরক্ষণ করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu sichert die Statistikkarten, die du erstellst, in deinen Fotos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu guarda en tus fotos las tarjetas de estadísticas que creas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu کارت‌های آماری را که می‌سازید در عکس‌هایتان ذخیره می‌کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sine-save ng Erhu sa iyong mga larawan ang mga stats card na ginagawa mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu enregistre dans vos photos les cartes de statistiques que vous créez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu आपके बनाए आँकड़ों के कार्ड आपकी फ़ोटो में सहेजता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu menyimpan kartu statistik yang kamu buat ke foto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu salva nelle tue foto le schede di statistiche che crei."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu は作成した統計カードを写真に保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu는 만든 통계 카드를 사진에 저장합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu bewaart de statistiekkaarten die je maakt in je foto's."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu zapisuje utworzone karty statystyk w Twoich zdjęciach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Erhu salva nas suas fotos os cartões de estatísticas que você cria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu сохраняет созданные вами карточки статистики в Фото."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் உருவாக்கும் புள்ளிவிவர அட்டைகளை Erhu உங்கள் புகைப்படங்களில் சேமிக்கிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు చేసే గణాంకాల కార్డ్‌లను Erhu మీ ఫోటోలలో సేవ్ చేస్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu จะบันทึกการ์ดสถิติที่คุณสร้างลงในรูปภาพ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu, oluşturduğun istatistik kartlarını fotoğraflarına kaydeder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu зберігає створені вами картки статистики у Фото."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu آپ کے بنائے ہوئے اعداد و شمار کے کارڈ آپ کی تصاویر میں محفوظ کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu lưu các thẻ thống kê bạn tạo vào Ảnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu 会将你制作的统计卡片存储到照片中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu 會將你製作的統計卡片儲存至照片。"
          }
        }
      }
    },
