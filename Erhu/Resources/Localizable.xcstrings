          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это скин виджета, а не цветовая тема. Скины в iOS не используются."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இது விட்ஜெட் தோல், வண்ணத் தீம் அல்ல. iOS இல் தோல்கள் பயன்படுத்தப்படுவதில்லை."
