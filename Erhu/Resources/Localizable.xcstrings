    "You can revisit this introduction in Settings → About Erhu. No Erhu account or music subscription is needed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك عرض هذه المقدمة مرة أخرى في الإعدادات ← حول Erhu. لا حاجة إلى حساب Erhu أو اشتراك موسيقى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই পরিচিতি আবার দেখতে পারেন সেটিংস → Erhu সম্পর্কে। Erhu অ্যাকাউন্ট বা গানের সাবস্ক্রিপশন লাগে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst diese Einführung unter Einstellungen → Über Erhu erneut ansehen. Du brauchst kein Erhu-Konto und kein Musik-Abo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes volver a esta introducción en Ajustes → Acerca de Erhu. No necesitas cuenta de Erhu ni suscripción musical."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
