    "Allow Erhu to find devices on your local network (Settings › Privacy & Security › Local Network)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح لـ Erhu بالعثور على الأجهزة في شبكتك المحلية (الإعدادات › الخصوصية والأمن › الشبكة المحلية)."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu-কে আপনার লোকাল নেটওয়ার্কে ডিভাইস খুঁজতে দিন (সেটিংস › গোপনীয়তা ও নিরাপত্তা › লোকাল নেটওয়ার্ক)।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Erhu, Geräte im lokalen Netzwerk zu finden (Einstellungen › Datenschutz & Sicherheit › Lokales Netzwerk)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que Erhu encuentre dispositivos en tu red local (Ajustes › Privacidad y seguridad › Red local)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به Erhu اجازه دهید دستگاه‌های شبکهٔ محلی را پیدا کند (تنظیمات › حریم خصوصی و امنیت › شبکهٔ محلی)."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payagan ang Erhu na maghanap ng mga device sa local network mo (Settings › Privacy at Security › Local Network)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Erhu à trouver des appareils sur votre réseau local (Réglages › Confidentialité et sécurité › Réseau local)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu को आपके लोकल नेटवर्क पर डिवाइस ढूँढने दें (सेटिंग › गोपनीयता और सुरक्षा › लोकल नेटवर्क)।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan Erhu menemukan perangkat di jaringan lokal Anda (Pengaturan › Privasi & Keamanan › Jaringan Lokal)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti a Erhu di trovare dispositivi sulla rete locale (Impostazioni › Privacy e sicurezza › Rete locale)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhuにローカルネットワーク上のデバイスの検出を許可してください（設定 › プライバシーとセキュリティ › ローカルネットワーク）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu가 로컬 네트워크의 기기를 찾도록 허용하세요(설정 › 개인정보 보호 및 보안 › 로컬 네트워크)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta Erhu toe apparaten op je lokale netwerk te vinden (Instellingen › Privacy en beveiliging › Lokaal netwerk)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól Erhu na znajdowanie urządzeń w sieci lokalnej (Ustawienia › Prywatność i ochrona › Sieć lokalna)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que o Erhu encontre dispositivos na sua rede local (Ajustes › Privacidade e Segurança › Rede Local)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите Erhu находить устройства в локальной сети («Настройки» › «Конфиденциальность и безопасность» › «Локальная сеть»)."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் உள்ளூர் பிணையத்தில் சாதனங்களைக் கண்டறிய Erhu ஐ அனுமதிக்கவும் (அமைப்புகள் › தனியுரிமை & பாதுகாப்பு › உள்ளூர் பிணையம்)."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ స్థానిక నెట్‌వర్క్‌లో పరికరాలను కనుగొనడానికి Erhu ను అనుమతించండి (సెట్టింగ్‌లు › గోప్యత & భద్రత › స్థానిక నెట్‌వర్క్)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาตให้ Erhu ค้นหาอุปกรณ์ในเครือข่ายท้องถิ่น (การตั้งค่า › ความเป็นส่วนตัวและความปลอดภัย › เครือข่ายท้องถิ่น)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu'nun yerel ağınızdaki cihazları bulmasına izin verin (Ayarlar › Gizlilik ve Güvenlik › Yerel Ağ)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозвольте Erhu знаходити пристрої в локальній мережі (Параметри › Конфіденційність і безпека › Локальна мережа)."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhu کو آپ کے مقامی نیٹ ورک پر ڈیوائسز تلاش کرنے دیں (سیٹنگز › رازداری اور سیکیورٹی › مقامی نیٹ ورک)۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép Erhu tìm thiết bị trong mạng cục bộ (Cài đặt › Quyền riêng tư & Bảo mật › Mạng cục bộ)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 Erhu 查找本地网络上的设备（设置 › 隐私与安全性 › 本地网络）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許 Erhu 查詢本地網路上的裝置（設定 › 隱私與安全性 › 本地網路）。"
          }
        }
      }
    },
