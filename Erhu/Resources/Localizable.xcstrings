    "Choose how long the tracks overlap. A transition never takes more than half of either track." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر مدة تداخل المقاطع. لا يستغرق الانتقال أكثر من نصف أي مقطع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ট্র্যাকগুলো কতক্ষণ ওভারল্যাপ করবে বেছে নিন। ট্রানজিশন কখনো কোনো ট্র্যাকের অর্ধেকের বেশি নেয় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, wie lange sich die Titel überlappen. Ein Übergang nimmt nie mehr als die Hälfte eines Titels ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cuánto se solapan las pistas. Una transición nunca ocupa más de la mitad de una pista."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدت هم‌پوشانی آهنگ‌ها را انتخاب کنید. گذار هرگز بیش از نیمی از هیچ آهنگی را نمی‌گیرد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin kung gaano katagal magsasapawan ang mga track. Hindi kailanman lalampas ang transition sa kalahati ng alinmang track."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez la durée de chevauchement des morceaux. Une transition ne dépasse jamais la moitié d’un morceau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनें कि ट्रैक कितनी देर एक-दूसरे पर चढ़ें। कोई ट्रांज़िशन किसी भी ट्रैक के आधे से ज़्यादा नहीं लेता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih berapa lama trek saling tumpang tindih. Transisi tidak pernah lebih dari setengah trek mana pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli quanto si sovrappongono i brani. Una transizione non occupa mai più di metà di un brano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲が重なる長さを選んでください。トランジションがどちらかの曲の半分を超えることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "곡이 겹치는 시간을 선택하세요. 트랜지션은 어느 곡이든 절반을 넘지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies hoe lang de nummers overlappen. Een overgang neemt nooit meer dan de helft van een nummer in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, jak długo utwory się nakładają. Przejście nigdy nie zajmuje więcej niż połowę któregokolwiek utworu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha quanto tempo as faixas se sobrepõem. Uma transição nunca ocupa mais da metade de qualquer faixa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, как долго треки перекрываются. Переход никогда не занимает больше половины любого трека."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "டிராக்குகள் எவ்வளவு நேரம் மேற்பொருந்த வேண்டும் எனத் தேர்ந்தெடுக்கவும். ஒரு மாற்றம் எந்த டிராக்கின் பாதிக்கு மேலும் எடுக்காது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ట్రాక్‌లు ఎంతసేపు ఒకదానిపై ఒకటి ఉండాలో ఎంచుకోండి. ట్రాన్సిషన్ ఏ ట్రాక్‌లోనూ సగానికి మించి తీసుకోదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกระยะเวลาที่แทร็กซ้อนกัน การเปลี่ยนผ่านจะไม่ยาวเกินครึ่งหนึ่งของแทร็กใด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parçaların ne kadar üst üste bineceğini seçin. Bir geçiş hiçbir parçanın yarısından uzun sürmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть, як довго треки накладаються. Перехід ніколи не займає більше половини будь-якого треку."
          }
        },
        "ur" : {
          "stringUnit" : {
