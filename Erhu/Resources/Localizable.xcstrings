    "Download the IPA for your current artwork variant and install it with your usual iOS installer." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نزّل ملف IPA لنسخة الصور الحالية وثبّته بأداة تثبيت iOS المعتادة لديك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার বর্তমান আর্টওয়ার্ক ভ্যারিয়েন্টের IPA ডাউনলোড করে আপনার সাধারণ iOS ইনস্টলার দিয়ে ইনস্টল করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade die IPA für deine aktuelle Cover-Variante herunter und installiere sie mit deinem üblichen iOS-Installer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga el IPA de tu variante de portadas actual e instálalo con tu instalador de iOS habitual."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPA مربوط به نوع تصویر فعلی را بارگیری کنید و با نصب‌کننده همیشگی iOS خود نصب کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-download ang IPA para sa kasalukuyang variant ng artwork mo at i-install ito gamit ang karaniwan mong iOS installer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargez l’IPA correspondant à votre variante de pochettes et installez-le avec votre outil d’installation iOS habituel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने मौजूदा आर्टवर्क वेरिएंट का IPA डाउनलोड करें और उसे अपने सामान्य iOS इंस्टॉलर से इंस्टॉल करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unduh IPA untuk varian sampul Anda saat ini dan pasang dengan pemasang iOS yang biasa Anda pakai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica l’IPA della tua variante di copertine e installalo con il solito installer per iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のアートワーク版の IPA をダウンロードし、いつもの iOS インストーラでインストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 아트워크 버전의 IPA를 다운로드한 후 평소 쓰는 iOS 설치 도구로 설치하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download de IPA voor je huidige hoesvariant en installeer hem met je gebruikelijke iOS-installatieprogramma."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobierz plik IPA dla obecnego wariantu okładek i zainstaluj go zwykłym instalatorem iOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixe o IPA da sua variante de capas atual e instale com o seu instalador de iOS de sempre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скачайте IPA для текущего варианта обложек и установите его привычным установщиком iOS."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் தற்போதைய கலைப்பட வகைக்கான IPA ஐப் பதிவிறக்கி, வழக்கமான iOS நிறுவியுடன் நிறுவவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ ప్రస్తుత ఆర్ట్‌వర్క్ వేరియంట్ IPA ని డౌన్‌లోడ్ చేసి, మీ సాధారణ iOS ఇన్‌స్టాలర్‌తో ఇన్‌స్టాల్ చేయండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดาวน์โหลด IPA สำหรับรุ่นภาพปกปัจจุบัน แล้วติดตั้งด้วยตัวติดตั้ง iOS ที่คุณใช้ประจำ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mevcut kapak türünüze uygun IPA’yı indirip her zamanki iOS yükleyicinizle kurun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завантажте IPA для поточного варіанта обкладинок і встановіть його звичним інсталятором iOS."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنے موجودہ آرٹ ورک ویریئنٹ کا IPA ڈاؤن لوڈ کریں اور اپنے معمول کے iOS انسٹالر سے انسٹال کریں۔"
