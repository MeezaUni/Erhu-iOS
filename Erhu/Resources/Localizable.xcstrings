        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN را در هر دو دستگاه خاموش کنید و نشانی را دقیقاً با http:// در ابتدا تایپ کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
