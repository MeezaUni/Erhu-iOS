    "Transitions are paused for this %@. Enable them on its page to hear saved transitions during playback." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الانتقالات متوقفة مؤقتًا لهذا %@. فعّلها في صفحته لسماع الانتقالات المحفوظة أثناء التشغيل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই %@-এর জন্য ট্রানজিশন বিরতিতে আছে। প্লেব্যাকের সময় সংরক্ষিত ট্রানজিশন শুনতে এর পৃষ্ঠায় চালু করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übergänge sind für dieses %@ pausiert. Aktiviere sie auf seiner Seite, um gespeicherte Übergänge bei der Wiedergabe zu hören."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las transiciones están en pausa para este %@. Actívalas en su página para oír las transiciones guardadas durante la reproducción."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گذارها برای این %@ متوقف شده‌اند. برای شنیدن گذارهای ذخیره‌شده هنگام پخش، آن‌ها را در صفحه‌اش فعال کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naka-pause ang mga transition para sa %@ na ito. I-on ang mga ito sa pahina nito para marinig ang mga naka-save na transition habang tumutugtog."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les transitions sont en pause pour ce %@. Activez-les sur sa page pour entendre les transitions enregistrées pendant la lecture."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस %@ के लिए ट्रांज़िशन रुके हुए हैं। प्लेबैक के दौरान सहेजे गए ट्रांज़िशन सुनने के लिए उसके पेज पर उन्हें चालू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transisi dijeda untuk %@ ini. Aktifkan di halamannya untuk mendengar transisi tersimpan saat pemutaran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
