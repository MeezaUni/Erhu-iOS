    "Only %lld of %lld sections had a dependable beat (about %lld BPM)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur %lld von %lld Abschnitten hatten einen verlässlichen Beat (etwa %lld BPM)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
