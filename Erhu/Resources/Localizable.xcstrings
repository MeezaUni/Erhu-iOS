        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@। জানা অনুপস্থিত ট্যাগ হাতে লিখুন, বা অনলাইনে আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Gib bekannte fehlende Tags von Hand ein oder versuche es online erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Introduce a mano las etiquetas conocidas que faltan o reinténtalo en línea."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. برچسب‌های ناموجود معلوم را دستی وارد کنید، یا آنلاین دوباره امتحان کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Ilagay nang manu-mano ang mga alam na kulang na tag, o subukang muli online."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Saisissez à la main les tags manquants connus ou réessayez en ligne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@। ज्ञात गुम टैग हाथ से भरें, या ऑनलाइन फिर कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Masukkan tag kosong yang diketahui secara manual, atau coba lagi online."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Inserisci a mano i tag mancanti noti o riprova online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。わかっている欠けたタグを手動で入力するか、オンラインで再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. 아는 빠진 태그를 직접 입력하거나 온라인으로 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Vul bekende ontbrekende tags met de hand in of probeer het online opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Wpisz znane brakujące tagi ręcznie albo spróbuj ponownie online."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Digite manualmente as tags que faltam e que você conhece, ou tente de novo online."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Введите известные недостающие теги вручную или повторите в сети."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. தெரிந்த விடுபட்ட குறிச்சொற்களைக் கைமுறையாக உள்ளிடவும், அல்லது இணையத்தில் மீண்டும் முயலவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. తెలిసిన లేని ట్యాగ్‌లను చేతితో నమోదు చేయండి, లేదా ఆన్‌లైన్‌లో మళ్ళీ ప్రయత్నించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ป้อนแท็กที่ขาดที่ทราบด้วยตนเอง หรือลองออนไลน์อีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Bilinen eksik etiketleri elle girin ya da çevrimiçi yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Введіть відомі відсутні теги вручну або повторіть у мережі."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@۔ معلوم غائب ٹیگز ہاتھ سے درج کریں، یا آن لائن دوبارہ کوشش کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Hãy nhập thủ công các thẻ thiếu đã biết, hoặc thử lại trực tuyến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。请手动输入已知的缺失标签，或在线重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。請手動輸入已知的缺失標籤，或線上重試。"
          }
        }
      }
    },
    "%@. Nothing more was looked up; resume when you're back online." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. لم يُبحث عن شيء آخر؛ تابع عند عودة الاتصال."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@। আর কিছু খোঁজা হয়নি; আবার অনলাইন হলে চালিয়ে যান।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Es wurde nichts weiter gesucht; setze fort, sobald du wieder online bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. No se buscó nada más; reanuda cuando vuelvas a tener conexión."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. چیز دیگری جست‌وجو نشد؛ وقتی دوباره آنلاین شدید ادامه دهید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Wala nang hinanap; magpatuloy kapag online ka na ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Rien d’autre n’a été recherché ; reprenez une fois de nouveau en ligne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@। आगे कुछ नहीं खोजा गया; ऑनलाइन होने पर फिर शुरू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Tidak ada lagi yang dicari; lanjutkan saat Anda kembali online."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Non è stato cercato altro; riprendi quando sei di nuovo online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。これ以上は検索していません。オンラインに戻ったら再開してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. 더 이상 조회하지 않았습니다. 다시 온라인이 되면 이어서 하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Er is niets meer opgezocht; ga verder zodra je weer online bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Nic więcej nie wyszukano; wznów po odzyskaniu połączenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Nada mais foi buscado; retome quando estiver online de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Больше ничего не искали; продолжите, когда снова будете в сети."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. மேலும் எதுவும் தேடப்படவில்லை; மீண்டும் இணையத்தில் இருக்கும்போது தொடரவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. ఇంకేమీ శోధించబడలేదు; మళ్ళీ ఆన్‌లైన్‌లో ఉన్నప్పుడు కొనసాగించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ไม่ได้ค้นหาอะไรเพิ่ม ดำเนินการต่อเมื่อกลับมาออนไลน์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Başka bir şey aranmadı; yeniden çevrimiçi olduğunuzda devam edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Більше нічого не шукали; продовжте, коли знову будете в мережі."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@۔ مزید کچھ تلاش نہیں کیا گیا؛ دوبارہ آن لائن ہونے پر جاری رکھیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Không tra cứu thêm gì; hãy tiếp tục khi có mạng lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。未再查询其他内容；恢复联网后请继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。未再查詢其他內容；恢復聯網後請繼續。"
          }
        }
      }
    },
