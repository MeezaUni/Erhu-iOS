    "Check the complete image and edition. Apply saves this image to your selected album or artist." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقّق من الصورة كاملة ومن الإصدار. يحفظ «تطبيق» هذه الصورة للألبوم أو الفنان المحدد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সম্পূর্ণ ছবি ও সংস্করণ যাচাই করুন। “প্রয়োগ করুন” এই ছবিটি আপনার নির্বাচিত অ্যালবাম বা শিল্পীর জন্য সংরক্ষণ করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe das vollständige Bild und die Ausgabe. Anwenden speichert dieses Bild für das gewählte Album oder den Interpreten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa la imagen completa y la edición. Aplicar guarda esta imagen en el álbum o artista elegido."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصویر کامل و نسخه را بررسی کنید. «اعمال» این تصویر را برای آلبوم یا هنرمند انتخاب‌شده ذخیره می‌کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suriin ang buong larawan at edisyon. Ise-save ng Ilapat ang larawang ito sa napili mong album o artist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez l’image complète et l’édition. Appliquer enregistre cette image pour l’album ou l’artiste choisi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरी छवि और संस्करण जाँचें। लागू करें इस छवि को चुने गए एल्बम या कलाकार के लिए सहेजता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Periksa gambar lengkap dan edisinya. Terapkan menyimpan gambar ini untuk album atau artis yang dipilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla l’immagine intera e l’edizione. Applica salva questa immagine per l’album o l’artista scelto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像全体とエディションを確認してください。「適用」を押すと、選択したアルバムまたはアーティストにこの画像が保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 이미지와 에디션을 확인하세요. 적용하면 선택한 앨범 또는 아티스트에 이 이미지가 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer de hele afbeelding en uitgave. Toepassen bewaart deze afbeelding voor het gekozen album of de artiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź cały obraz i wydanie. Zastosuj zapisuje ten obraz dla wybranego albumu lub wykonawcy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confira a imagem inteira e a edição. Aplicar salva esta imagem no álbum ou artista escolhido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте изображение целиком и издание. «Применить» сохраняет это изображение для выбранного альбома или исполнителя."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "முழுப் படத்தையும் பதிப்பையும் சரிபார்க்கவும். “பயன்படுத்து” இந்தப் படத்தை நீங்கள் தேர்ந்தெடுத்த ஆல்பம் அல்லது கலைஞருக்குச் சேமிக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పూర్తి చిత్రం, ఎడిషన్‌ను తనిఖీ చేయండి. “వర్తింపజేయండి” ఈ చిత్రాన్ని మీరు ఎంచుకున్న ఆల్బమ్ లేదా కళాకారుడికి సేవ్ చేస్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจดูภาพทั้งหมดและรุ่นที่วางจำหน่าย “ใช้” จะบันทึกภาพนี้ให้อัลบั้มหรือศิลปินที่เลือก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görselin tamamını ve sürümü kontrol edin. Uygula, bu görseli seçili albüm veya sanatçıya kaydeder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірте повне зображення та видання. «Застосувати» зберігає це зображення для вибраного альбому чи виконавця."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مکمل تصویر اور ایڈیشن چیک کریں۔ “لاگو کریں” یہ تصویر آپ کے منتخب البم یا فنکار کے لیے محفوظ کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra toàn bộ ảnh và ấn bản. Áp dụng sẽ lưu ảnh này cho album hoặc nghệ sĩ đã chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查完整图片和版本。“应用”会将此图片保存到所选专辑或艺人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請檢查完整圖片和版本。「應用」會將此圖片儲存到所選專輯或藝人。"
          }
        }
      }
    },
    "Check your albums to find available covers." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افحص ألبوماتك للعثور على الأغلفة المتاحة."
