        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ڈاؤن لوڈ شدہ متحرک کور والے البمز: %lld۔ چھوڑے گئے البمز الگ سے دیکھنے کے لیے فہرست میں رہتے ہیں۔"
