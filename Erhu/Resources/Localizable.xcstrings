        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar la letra. Comprueba el almacenamiento disponible e inténtalo de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متن ترانه ذخیره نشد. فضای موجود را بررسی و دوباره امتحان کنید."
