          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイル自体に保存されます（%@）。空欄の項目はファイルの値を保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
