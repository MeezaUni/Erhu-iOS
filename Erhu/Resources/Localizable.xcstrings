    "Lyrics could not be saved. Check available storage and retry." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر حفظ الكلمات. تحقق من مساحة التخزين المتاحة وحاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গানের কথা সংরক্ষণ করা যায়নি। উপলব্ধ স্টোরেজ দেখে আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
