    "Storage is full. Covers saved: %lld. Free space, then try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التخزين ممتلئ. الأغلفة المحفوظة: %lld. حرّر مساحة وحاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্টোরেজ পূর্ণ। সংরক্ষিত কভার: %lld। জায়গা খালি করে আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speicher voll. Gespeicherte Cover: %lld. Gib Speicher frei und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El almacenamiento está lleno. Portadas guardadas: %lld. Libera espacio e inténtalo de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فضای ذخیره‌سازی پر است. جلدهای ذخیره‌شده: %lld. فضا آزاد کنید و دوباره امتحان کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puno na ang storage. Mga na-save na cover: %lld. Magbakante ng espasyo at subukang muli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stockage plein. Pochettes enregistrées : %lld. Libérez de l’espace puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्टोरेज भर गई है। सहेजे गए कवर: %lld। जगह खाली करके फिर कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyimpanan penuh. Sampul disimpan: %lld. Kosongkan ruang, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spazio esaurito. Copertine salvate: %lld. Libera spazio e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストレージがいっぱいです。保存したカバー：%lld。空き容量を作ってからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장 공간이 가득 찼습니다. 저장한 커버: %lld. 공간을 확보한 뒤 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opslag vol. Bewaarde hoezen: %lld. Maak ruimte vrij en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak miejsca. Zapisane okładki: %lld. Zwolnij miejsce i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Armazenamento cheio. Capas salvas: %lld. Libere espaço e tente de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранилище заполнено. Сохранено обложек: %lld. Освободите место и повторите."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சேமிப்பகம் நிரம்பியது. சேமித்த அட்டைகள்: %lld. இடத்தை விடுவித்து மீண்டும் முயலவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నిల్వ నిండింది. సేవ్ చేసిన కవర్లు: %lld. స్థలాన్ని ఖాళీ చేసి మళ్ళీ ప్రయత్నించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พื้นที่เต็ม ปกที่บันทึก: %lld ทำให้มีพื้นที่ว่างแล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depolama dolu. Kaydedilen kapak: %lld. Yer açıp yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сховище заповнене. Збережено обкладинок: %lld. Звільніть місце й спробуйте знову."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسٹوریج بھر گئی ہے۔ محفوظ کورز: %lld۔ جگہ خالی کر کے دوبارہ کوشش کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ nhớ đầy. Ảnh bìa đã lưu: %lld. Hãy giải phóng dung lượng rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存储空间已满。已保存封面：%lld。请释放空间后重试。"
