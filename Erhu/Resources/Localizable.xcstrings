        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте альбомы, чтобы найти доступные обложки."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கிடைக்கும் அட்டைகளைக் கண்டறிய உங்கள் ஆல்பங்களைச் சரிபார்க்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అందుబాటులో ఉన్న కవర్‌లను కనుగొనడానికి మీ ఆల్బమ్‌లను తనిఖీ చేయండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจอัลบั้มของคุณเพื่อหาปกที่มีให้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mevcut kapakları bulmak için albümlerinizi kontrol edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірте свої альбоми, щоб знайти доступні обкладинки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دستیاب کورز تلاش کرنے کے لیے اپنے البمز چیک کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra album của bạn để tìm ảnh bìa có sẵn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查你的专辑以查找可用的封面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢查你的專輯以查詢可用的封面。"
          }
        }
      }
    },
    "Check your albums, then download available motion covers for muted offline playback. Lock Screen animation depends on iOS." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افحص ألبوماتك، ثم نزّل الأغلفة المتحركة المتاحة للتشغيل الصامت دون اتصال. تعتمد الحركة على شاشة القفل على iOS."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার অ্যালবাম যাচাই করুন, তারপর নিঃশব্দ অফলাইন প্লেব্যাকের জন্য উপলব্ধ মোশন কভার ডাউনলোড করুন। লক স্ক্রিনের অ্যানিমেশন iOS-এর উপর নির্ভর করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe deine Alben und lade verfügbare animierte Cover für die stumme Offline-Wiedergabe herunter. Die Animation auf dem Sperrbildschirm hängt von iOS ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa tus álbumes y descarga las portadas animadas disponibles para verlas sin sonido y sin conexión. La animación en la pantalla de bloqueo depende de iOS."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آلبوم‌هایتان را بررسی کنید، سپس جلدهای متحرک موجود را برای پخش بی‌صدای آفلاین بارگیری کنید. پویانمایی صفحه قفل به iOS بستگی دارد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tingnan ang mga album mo, saka i-download ang mga available na motion cover para sa naka-mute na offline playback. Nakadepende sa iOS ang animation sa Lock Screen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez vos albums, puis téléchargez les pochettes animées disponibles pour une lecture muette hors ligne. L’animation sur l’écran verrouillé dépend d’iOS."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने एल्बम जाँचें, फिर बिना आवाज़ वाले ऑफ़लाइन प्लेबैक के लिए उपलब्ध मोशन कवर डाउनलोड करें। लॉक स्क्रीन पर एनिमेशन iOS पर निर्भर करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Periksa album Anda, lalu unduh sampul bergerak yang tersedia untuk pemutaran tanpa suara secara offline. Animasi di Layar Terkunci bergantung pada iOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla i tuoi album, poi scarica le copertine animate disponibili per la riproduzione muta offline. L’animazione nella schermata di blocco dipende da iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アルバムを確認し、利用可能なモーションカバーをダウンロードして、消音でオフライン再生します。ロック画面のアニメーションは iOS によります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앨범을 확인한 후 사용 가능한 모션 커버를 다운로드해 무음으로 오프라인 재생하세요. 잠금 화면 애니메이션은 iOS에 따라 다릅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer je albums en download beschikbare bewegende hoezen om ze geluidloos en offline af te spelen. Animatie op het toegangsscherm hangt af van iOS."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź albumy, a potem pobierz dostępne animowane okładki do wyciszonego odtwarzania offline. Animacja na ekranie blokady zależy od iOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique seus álbuns e baixe as capas animadas disponíveis para reprodução sem som e offline. A animação na tela de bloqueio depende do iOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте альбомы и загрузите доступные анимированные обложки для беззвучного офлайн-воспроизведения. Анимация на экране блокировки зависит от iOS."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் ஆல்பங்களைச் சரிபார்த்து, ஒலியில்லா ஆஃப்லைன் இயக்கத்துக்காகக் கிடைக்கும் அசைவு அட்டைகளைப் பதிவிறக்கவும். பூட்டுத் திரை அசைவூட்டம் iOS ஐச் சார்ந்தது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ ఆల్బమ్‌లను తనిఖీ చేసి, మ్యూట్ ఆఫ్‌లైన్ ప్లేబ్యాక్ కోసం అందుబాటులో ఉన్న మోషన్ కవర్‌లను డౌన్‌లోడ్ చేయండి. లాక్ స్క్రీన్ యానిమేషన్ iOS పై ఆధారపడుతుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจอัลบั้มของคุณ แล้วดาวน์โหลดปกเคลื่อนไหวที่มีให้สำหรับเล่นแบบปิดเสียงออฟไลน์ ภาพเคลื่อนไหวบนหน้าจอล็อกขึ้นอยู่กับ iOS"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albümlerinizi kontrol edin, sonra sessiz çevrimdışı oynatma için mevcut hareketli kapakları indirin. Kilit ekranındaki animasyon iOS’a bağlıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірте свої альбоми, а потім завантажте доступні анімовані обкладинки для беззвучного офлайн-відтворення. Анімація на екрані блокування залежить від iOS."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنے البمز چیک کریں، پھر خاموش آف لائن پلے بیک کے لیے دستیاب متحرک کورز ڈاؤن لوڈ کریں۔ لاک اسکرین کی اینیمیشن iOS پر منحصر ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra album của bạn, rồi tải ảnh bìa động có sẵn để phát không tiếng, ngoại tuyến. Hoạt ảnh trên Màn hình khóa phụ thuộc iOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查你的专辑，然后下载可用的动态封面以静音离线播放。锁定屏幕动画取决于 iOS。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢查你的專輯，然後下載可用的動態封面以靜音離線播放。鎖定畫面動畫取決於 iOS。"
          }
        }
      }
    },
