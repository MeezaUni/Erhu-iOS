    "Turn off a VPN on either device, and type the address exactly, starting with http://." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقف VPN على الجهازين، واكتب العنوان بدقة بدءًا بـ http://."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দুটি ডিভাইসেই VPN বন্ধ করুন, আর http:// দিয়ে শুরু করে ঠিকানা হুবহু লিখুন।"
          }
        },
        "de" : {
          "stringUnit" : {
