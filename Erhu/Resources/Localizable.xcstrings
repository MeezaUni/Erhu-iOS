          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённые оригиналы тоже удаляются, поэтому изменения больше нельзя будет отменить."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வைத்திருந்த மூலங்களும் நீக்கப்படும், எனவே மாற்றங்களை இனி திரும்பப் பெற முடியாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఉంచిన అసలు కాపీలు కూడా తొలగించబడతాయి, కాబట్టి మార్పులను ఇక తిరిగి మార్చలేరు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้นฉบับที่เก็บไว้จะถูกลบด้วย จึงย้อนกลับการเปลี่ยนแปลงไม่ได้อีก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saklanan orijinaller de silinir, bu yüzden değişiklikler artık geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережені оригінали теж буде видалено, тож зміни більше не можна буде скасувати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رکھے گئے اصل نسخے بھی حذف ہو جاتے ہیں، اس لیے تبدیلیاں اب واپس نہیں لائی جا سکیں گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các bản gốc được giữ cũng bị xóa, nên không thể hoàn tác thay đổi nữa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
