    "Online lyrics are temporarily unavailable. You can search the web instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Online-Songtexte sind vorübergehend nicht verfügbar. Du kannst stattdessen im Web suchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las letras en línea no están disponibles por ahora. Puedes buscar en la web."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paroles en ligne sont momentanément indisponibles. Vous pouvez chercher sur le web."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑनलाइन बोल अभी उपलब्ध नहीं हैं। आप वेब पर खोज सकते हैं।"
