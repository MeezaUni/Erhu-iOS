          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasos de 100 ms · la duración efectiva depende de ambas canciones y sus puntos de entrada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گام‌های ۱۰۰ میلی‌ثانیه · طول واقعی به هر دو آهنگ و نقطه‌های شروعشان محدود است."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mga hakbang na 100 ms · ang aktuwal na haba ay limitado ng dalawang kanta at ng kanilang mga cue point."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de 100 ms · la durée réelle dépend des deux morceaux et de leurs repères."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 ms के चरण · असली लंबाई दोनों गानों और उनके क्यू पॉइंट पर निर्भर करती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langkah 100 md · panjang sebenarnya dibatasi oleh kedua lagu dan titik cue-nya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passi di 100 ms · la durata effettiva dipende da entrambi i brani e dai loro punti cue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 ms 単位 · 実際の長さは両方の曲とそのキューポイントで制限されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 ms 단위 · 실제 길이는 두 곡과 큐 포인트에 따라 제한됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stappen van 100 ms · de werkelijke lengte hangt af van beide nummers en hun cuepunten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kroki co 100 ms · rzeczywistą długość ograniczają oba utwory i ich punkty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passos de 100 ms · a duração real depende das duas músicas e dos seus pontos de corte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шаг 100 мс · фактическая длина ограничена обоими треками и их метками."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 ms படிகள் · உண்மையான நீளம் இரு பாடல்கள் மற்றும் அவற்றின் க்யூ புள்ளிகளால் வரம்பிடப்படுகிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 ms దశలు · వాస్తవ నిడివి రెండు పాటలు, వాటి క్యూ పాయింట్ల ద్వారా పరిమితమవుతుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทีละ 100 มิลลิวินาที · ความยาวจริงถูกจำกัดด้วยทั้งสองเพลงและจุดคิวของเพลงนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 ms adımlar · gerçek süre iki şarkıya ve işaret noktalarına bağlıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крок 100 мс · фактична тривалість обмежена обома піснями та їхніми точками cue."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 ms کے قدم · اصل لمبائی دونوں گانوں اور ان کے کیو پوائنٹس سے محدود ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bước 100 ms · độ dài thực tế bị giới hạn bởi cả hai bài và điểm cue của chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以 100 毫秒为步长 · 实际长度受两首歌曲及其提示点限制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以 100 毫秒為步長 · 實際長度受兩首歌曲及其提示點限制。"
          }
        }
      }
    },
