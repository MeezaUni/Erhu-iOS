    "Apple asked to wait before trying again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طلبت Apple الانتظار قبل المحاولة مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple আবার চেষ্টার আগে অপেক্ষা করতে বলেছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple hat gebeten, vor einem erneuten Versuch zu warten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple pidió esperar antes de volver a intentarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple خواست پیش از تلاش دوباره صبر کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiniling ng Apple na maghintay muna bago subukang muli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple a demandé d’attendre avant de réessayer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ने दोबारा कोशिश से पहले रुकने को कहा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple meminta menunggu sebelum mencoba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ha chiesto di attendere prima di riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleから再試行まで待つよう求められました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple에서 다시 시도하기 전에 기다리라고 요청했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple vroeg om te wachten voordat je het opnieuw probeert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple poprosiło o odczekanie przed ponowną próbą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Apple pediu para esperar antes de tentar de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple попросила подождать перед повторной попыткой."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மீண்டும் முயலும் முன் காத்திருக்க Apple கேட்டது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మళ్ళీ ప్రయత్నించే ముందు వేచి ఉండమని Apple కోరింది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ขอให้รอก่อนลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple yeniden denemeden önce beklemeyi istedi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple попросила зачекати перед повторною спробою."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple نے دوبارہ کوشش سے پہلے انتظار کرنے کو کہا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
