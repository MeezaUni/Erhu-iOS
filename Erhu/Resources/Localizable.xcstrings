    "Add songs here, or choose \"Fix tags online\" in any song's menu." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف الأغاني هنا، أو اختر «إصلاح الوسوم عبر الإنترنت» من قائمة أي أغنية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখানে গান যোগ করুন, বা যেকোনো গানের মেনুতে “অনলাইনে ট্যাগ ঠিক করুন” বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge hier Titel hinzu oder wähle „Tags online korrigieren“ im Menü eines Titels."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade canciones aquí o elige «Corregir etiquetas en línea» en el menú de cualquier canción."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آهنگ‌ها را اینجا اضافه کنید یا در منوی هر آهنگ «اصلاح برچسب‌ها به‌صورت آنلاین» را انتخاب کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magdagdag ng kanta rito, o piliin ang “Ayusin ang tag online” sa menu ng anumang kanta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des morceaux ici, ou choisissez « Corriger les tags en ligne » dans le menu d’un morceau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहाँ गाने जोड़ें, या किसी भी गाने के मेनू में “टैग ऑनलाइन ठीक करें” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan lagu di sini, atau pilih “Perbaiki tag online” di menu lagu mana pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi brani qui o scegli “Correggi tag online” nel menu di un brano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここに曲を追加するか、曲のメニューで「オンラインでタグを修正」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기에 노래를 추가하거나 노래 메뉴에서 “온라인으로 태그 수정”을 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg hier nummers toe, of kies ‘Tags online herstellen’ in het menu van een nummer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj tu utwory albo wybierz „Popraw tagi online” w menu dowolnego utworu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione músicas aqui ou escolha “Corrigir tags online” no menu de qualquer música."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте треки сюда или выберите «Исправить теги онлайн» в меню любого трека."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இங்கே பாடல்களைச் சேர்க்கவும், அல்லது எந்தப் பாடலின் மெனுவிலும் “ஆன்லைனில் குறிச்சொற்களைச் சரிசெய்” என்பதைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇక్కడ పాటలు జోడించండి, లేదా ఏదైనా పాట మెనూలో “ఆన్‌లైన్‌లో ట్యాగ్‌లు సరిచేయండి” ఎంచుకోండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มเพลงที่นี่ หรือเลือก “แก้แท็กออนไลน์” ในเมนูของเพลงใดก็ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şarkıları buraya ekleyin veya herhangi bir şarkının menüsünde “Etiketleri çevrimiçi düzelt”i seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте пісні сюди або виберіть «Виправити теги онлайн» у меню будь-якої пісні."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہاں گانے شامل کریں، یا کسی بھی گانے کے مینو میں “ٹیگز آن لائن درست کریں” منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm bài hát vào đây, hoặc chọn “Sửa thẻ trực tuyến” trong menu của bài bất kỳ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此添加歌曲，或在任意歌曲的菜单中选择“在线修复标签”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此新增歌曲，或在任意歌曲的選單中選擇「線上修復標籤」。"
          }
        }
      }
    },
    "Add songs or find the ones with missing tags first." : {
      "localizations" : {
        "ar" : {
