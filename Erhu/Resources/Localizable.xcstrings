    "Using each matched reference equally to find similar tracks." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُعطى كل مرجع معثور عليه وزنًا متساويًا للعثور على مقاطع مشابهة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মিলে যাওয়া প্রতিটি রেফারেন্স সমানভাবে ব্যবহার করে মিলে যাওয়া ট্র্যাক খোঁজা হচ্ছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede gefundene Referenz wird gleich gewichtet, um ähnliche Titel zu finden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa cada referencia emparejada por igual para encontrar pistas similares."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای یافتن قطعه‌های مشابه به هر مرجع یافت‌شده وزن برابر داده می‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binibigyan ng pantay na bigat ang bawat nakitang reference para maghanap ng katulad na track."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque référence associée compte autant pour trouver des pistes similaires."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मिलते-जुलते ट्रैक खोजने के लिए हर मिले संदर्भ को बराबर महत्व दिया जा रहा है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap referensi yang cocok dipakai setara untuk menemukan trek serupa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni riferimento abbinato pesa allo stesso modo nella ricerca di tracce simili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一致した参考曲を均等に使って似た曲を探しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일치한 참조를 똑같이 반영해 비슷한 트랙을 찾고 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke gekoppelde referentie telt even zwaar mee om vergelijkbare tracks te vinden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde dopasowane odniesienie ma równy wpływ na wyszukiwanie podobnych utworów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada referência correspondida pesa igual na busca por faixas parecidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый найденный образец одинаково влияет на поиск похожих треков."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒத்த டிராக்குகளைக் கண்டறியக் கிடைத்த ஒவ்வொரு குறிப்புக்கும் சம எடை தரப்படுகிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సారూప్య ట్రాక్‌లను కనుగొనడానికి దొరికిన ప్రతి సూచనకు సమాన బరువు ఇవ్వబడుతోంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้เพลงอ้างอิงที่ตรงกันแต่ละเพลงอย่างเท่ากันเพื่อหาแทร็กที่คล้าย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benzer parçaları bulmak için her eşleşen referans eşit ağırlıkta kullanılıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен знайдений зразок однаково впливає на пошук схожих треків."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملتے جلتے ٹریکس تلاش کرنے کے لیے ہر ملے حوالے کو برابر اہمیت دی جا رہی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi bài tham chiếu đã ghép được dùng như nhau để tìm bài tương tự."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在平等地使用每个匹配的参考来查找相似曲目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在平等地使用每個匹配的參考來查詢相似曲目。"
          }
        }
      }
    },
