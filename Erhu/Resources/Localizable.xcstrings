    "A home for the music you own. Your collection and listening history stay on this iPhone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Zuhause für die Musik, die dir gehört. Deine Sammlung und dein Hörverlauf bleiben auf diesem iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un hogar para la música que tienes. Tu colección y tu historial de escucha se quedan en este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un foyer pour la musique que vous possédez. Votre collection et votre historique d’écoute restent sur cet iPhone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके अपने संगीत का घर। आपका संग्रह और सुनने का इतिहास इसी iPhone पर रहता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
