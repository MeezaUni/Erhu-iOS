          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置 A"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 A"
          }
        }
      }
    },
    "Set A and B while listening. Looping jumps back to A each time playback reaches B." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عيّن A وB أثناء الاستماع. يعود التكرار إلى A في كل مرة يصل فيها التشغيل إلى B."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শোনার সময় A ও B সেট করুন। প্লেব্যাক প্রতিবার B-তে পৌঁছালে লুপ A-তে ফিরে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze A und B beim Hören. Die Schleife springt jedes Mal zu A zurück, wenn die Wiedergabe B erreicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fija A y B mientras escuchas. El bucle vuelve a A cada vez que la reproducción llega a B."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنگام گوش دادن A و B را تنظیم کنید. هر بار پخش به B برسد، حلقه به A برمی‌گردد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itakda ang A at B habang nakikinig. Babalik sa A ang loop tuwing aabot sa B ang playback."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez A et B pendant l’écoute. La boucle revient à A chaque fois que la lecture atteint B."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुनते हुए A और B सेट करें। प्लेबैक हर बार B पर पहुँचने पर लूप A पर लौट आता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetapkan A dan B sambil mendengarkan. Loop kembali ke A setiap kali pemutaran mencapai B."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta A e B durante l’ascolto. Il loop torna ad A ogni volta che la riproduzione raggiunge B."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聴きながら A と B を設定します。再生が B に達するたびに A に戻ってループします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "들으면서 A와 B를 설정하세요. 재생이 B에 닿을 때마다 A로 돌아가 반복합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel A en B in tijdens het luisteren. De lus springt terug naar A telkens als het afspelen B bereikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw A i B podczas słuchania. Pętla wraca do A za każdym razem, gdy odtwarzanie dojdzie do B."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina A e B enquanto ouve. O loop volta para A sempre que a reprodução chega a B."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задайте A и B во время прослушивания. Петля возвращается к A каждый раз, когда воспроизведение доходит до B."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கேட்கும்போது A மற்றும் B ஐ அமைக்கவும். ஒவ்வொரு முறை இயக்கம் B ஐ அடையும்போதும் சுழற்சி A க்குத் திரும்பும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "వింటున్నప్పుడు A, B సెట్ చేయండి. ప్లేబ్యాక్ B చేరిన ప్రతిసారీ లూప్ A కు తిరిగి వెళ్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้ง A และ B ขณะฟัง การวนซ้ำจะกลับไปที่ A ทุกครั้งที่เล่นถึง B"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinlerken A ve B’yi ayarlayın. Döngü, çalma B’ye her ulaştığında A’ya döner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встановіть A і B під час прослуховування. Цикл повертається до A щоразу, коли відтворення доходить до B."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سنتے ہوئے A اور B مقرر کریں۔ ہر بار پلے بیک B پر پہنچنے پر لوپ A پر واپس جاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt A và B khi đang nghe. Vòng lặp quay lại A mỗi khi phát đến B."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在聆听时设置 A 和 B。每次播放到 B 时都会跳回 A 循环。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在聆聽時設定 A 和 B。每次播放到 B 時都會跳回 A 迴圈。"
          }
        }
      }
    },
