    "%lld×" : {},
    "+100 ms" : {},
    "- Peaks are sample peaks measured after the EQ; peaks between samples are not measured." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- الذرى هي ذرى العينات المقاسة بعد المعادل؛ لا تُقاس الذرى بين العينات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- পিক হলো EQ-এর পরে মাপা স্যাম্পল পিক; স্যাম্পলের মাঝের পিক মাপা হয় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Peaks sind Sample-Peaks nach dem EQ; Peaks zwischen Samples werden nicht gemessen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Los picos son picos de muestra medidos tras el EQ; los picos entre muestras no se miden."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- اوج‌ها اوج نمونه‌هایی‌اند که پس از EQ اندازه‌گیری شده‌اند؛ اوج‌های بین نمونه‌ها اندازه‌گیری نمی‌شوند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Ang mga peak ay mga sample peak na nasukat pagkatapos ng EQ; hindi sinusukat ang mga peak sa pagitan ng mga sample."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Les crêtes sont des crêtes d’échantillon mesurées après l’EQ ; les crêtes entre échantillons ne sont pas mesurées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- पीक EQ के बाद मापे गए सैंपल पीक हैं; सैंपलों के बीच के पीक नहीं मापे जाते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Puncak adalah puncak sampel yang diukur setelah EQ; puncak di antara sampel tidak diukur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- I picchi sono picchi di campione misurati dopo l’EQ; i picchi tra campioni non vengono misurati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- ピークはEQ後に測定したサンプルピークです。サンプル間のピークは測定しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- 피크는 EQ 이후에 측정한 샘플 피크이며, 샘플 사이의 피크는 측정하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Pieken zijn samplepieken gemeten na de EQ; pieken tussen samples worden niet gemeten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Szczyty to szczyty próbek mierzone po EQ; szczyty między próbkami nie są mierzone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Os picos são picos de amostra medidos após o EQ; picos entre amostras não são medidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Пики — это пики сэмплов после эквалайзера; пики между сэмплами не измеряются."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- உச்சங்கள் EQ-க்குப் பின் அளந்த மாதிரி உச்சங்கள்; மாதிரிகளுக்கு இடையிலான உச்சங்கள் அளக்கப்படுவதில்லை."
          }
        },
        "te" : {
