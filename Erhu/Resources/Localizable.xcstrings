        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que le moteur audio de l’app indique pour le morceau en cours : le format dans lequel le fichier est décodé, et celui qu’il transmet à iOS après le traitement de l’app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप का ऑडियो इंजन मौजूदा ट्रैक के बारे में क्या बताता है: फ़ाइल किस फ़ॉर्मैट में डिकोड होती है, और ऐप की प्रोसेसिंग के बाद iOS को किस फ़ॉर्मैट में दी जाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
