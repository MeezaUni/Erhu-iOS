    "iOS is not accepting animated artwork on this device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يقبل iOS الأغلفة المتحركة على هذا الجهاز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS এই ডিভাইসে অ্যানিমেটেড কভার নিচ্ছে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS nimmt auf diesem Gerät keine bewegten Cover an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS no acepta portadas animadas en este dispositivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS روی این دستگاه جلدهای متحرک را نمی‌پذیرد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
