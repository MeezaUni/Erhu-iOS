          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजी गई प्रगति बहाल हुई। बाकी ट्रैक के साथ जारी रखें; पूरे हुए छोड़ दिए जाएँगे।"
