        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gecontroleerde albums: %lld. Beschikbare bewegende hoezen: %lld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdzone albumy: %lld. Dostępne animowane okładki: %lld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Álbuns verificados: %lld. Capas animadas disponíveis: %lld."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверено альбомов: %lld. Доступно анимированных обложек: %lld."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சரிபார்த்த ஆல்பங்கள்: %lld. கிடைக்கும் இயங்கும் அட்டைகள்: %lld."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "తనిఖీ చేసిన ఆల్బమ్‌లు: %lld. అందుబాటులో ఉన్న యానిమేటెడ్ కవర్లు: %lld."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อัลบั้มที่ตรวจแล้ว: %lld ปกเคลื่อนไหวที่มี: %lld"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
