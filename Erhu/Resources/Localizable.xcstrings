        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்த அறிமுகத்தை அமைப்புகள் → Erhu பற்றி இல் மீண்டும் பார்க்கலாம். Erhu கணக்கோ இசைச் சந்தாவோ தேவையில்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈ పరిచయాన్ని సెట్టింగ్‌లు → Erhu గురించి లో మళ్ళీ చూడవచ్చు. Erhu ఖాతా లేదా సంగీత సభ్యత్వం అవసరం లేదు."
          }
        },
        "th" : {
          "stringUnit" : {
