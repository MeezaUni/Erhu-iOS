    "Using each matched reference equally to find similar tracks." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede gefundene Referenz wird gleich gewichtet, um ähnliche Titel zu finden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa cada referencia emparejada por igual para encontrar pistas similares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque référence associée compte autant pour trouver des pistes similaires."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मिलते-जुलते ट्रैक खोजने के लिए हर मिले संदर्भ को बराबर महत्व दिया जा रहा है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap referensi yang cocok dipakai setara untuk menemukan trek serupa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni riferimento abbinato pesa allo stesso modo nella ricerca di tracce simili."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke gekoppelde referentie telt even zwaar mee om vergelijkbare tracks te vinden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde dopasowane odniesienie ma równy wpływ na wyszukiwanie podobnych utworów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada referência correspondida pesa igual na busca por faixas parecidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
