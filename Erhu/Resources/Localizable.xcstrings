    "Synced lyrics couldn’t be checked while offline." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر التحقق من الكلمات المتزامنة لعدم الاتصال."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অফলাইনে থাকায় সিঙ্ক করা কথা যাচাই করা যায়নি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisierte Songtexte konnten offline nicht geprüft werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron comprobar las letras sincronizadas sin conexión."
