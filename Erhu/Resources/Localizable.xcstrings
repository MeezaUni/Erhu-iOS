        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progres tersimpan dipulihkan. Lanjutkan dengan trek yang tersisa; yang sudah selesai dilewati."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progressi salvati ripristinati. Continua con le tracce restanti; quelle completate vengono saltate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存した進行状況を復元しました。残りのトラックで続行します。完了済みのものはスキップされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 진행 상황을 복원했습니다. 나머지 트랙으로 계속합니다. 완료한 트랙은 건너뜁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaarde voortgang hersteld. Ga verder met de resterende tracks; voltooide worden overgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywrócono zapisany postęp. Kontynuuj z pozostałymi utworami; ukończone zostaną pominięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progresso salvo restaurado. Continue com as faixas restantes; as concluídas são puladas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённый прогресс восстановлен. Продолжайте с оставшимися треками; завершённые пропускаются."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சேமித்த முன்னேற்றம் மீட்டெடுக்கப்பட்டது. மீதமுள்ள டிராக்குகளுடன் தொடரவும்; முடிந்த டிராக்குகள் தவிர்க்கப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సేవ్ చేసిన పురోగతి పునరుద్ధరించబడింది. మిగిలిన ట్రాక్‌లతో కొనసాగించండి; పూర్తయిన ట్రాక్‌లు దాటవేయబడతాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กู้คืนความคืบหน้าที่บันทึกไว้แล้ว ดำเนินการต่อกับแทร็กที่เหลือ แทร็กที่เสร็จแล้วจะถูกข้าม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydedilen ilerleme geri yüklendi. Kalan parçalarla devam edin; tamamlananlar atlanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережений поступ відновлено. Продовжуйте з рештою треків; завершені пропускаються."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محفوظ پیش رفت بحال ہو گئی۔ باقی ٹریکس کے ساتھ جاری رکھیں؛ مکمل ٹریکس چھوڑ دیے جائیں گے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã khôi phục tiến độ đã lưu. Tiếp tục với các bài còn lại; bài đã xong sẽ được bỏ qua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已恢复保存的进度。继续处理剩余曲目；已完成的会跳过。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已恢復儲存的進度。繼續處理剩餘曲目；已完成的會跳過。"
          }
        }
      }
    },
    "Saved progress: checked %lld of %lld albums. Continue to check remaining or newly added albums." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حفظ التقدم: فُحص %1$lld من %2$lld ألبومات. تابع لفحص الألبومات المتبقية أو المضافة حديثًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অগ্রগতি সংরক্ষিত: %2$lldটি অ্যালবামের মধ্যে %1$lldটি যাচাই হয়েছে। বাকি বা নতুন যোগ করা অ্যালবাম যাচাই করতে চালিয়ে যান।"
