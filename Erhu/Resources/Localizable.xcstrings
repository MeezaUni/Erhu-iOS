          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิด VPN บนอุปกรณ์ทั้งสอง และพิมพ์ที่อยู่ให้ตรงทุกตัว โดยขึ้นต้นด้วย http://"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki cihazda da VPN'i kapatın ve adresi http:// ile başlayarak tam olarak yazın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
