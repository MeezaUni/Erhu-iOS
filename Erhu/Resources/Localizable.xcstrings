    "Keep Erhu open while sending: iOS pauses the transfer when the app is in the background." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass Erhu beim Senden geöffnet: iOS pausiert die Übertragung, wenn die App im Hintergrund ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén Erhu abierto mientras envías: iOS pausa la transferencia cuando la app está en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez Erhu ouvert pendant l’envoi : iOS met le transfert en pause quand l’app est en arrière-plan."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भेजते समय Erhu खुला रखें: ऐप बैकग्राउंड में होने पर iOS ट्रांसफ़र रोक देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biarkan Erhu terbuka saat mengirim: iOS menjeda transfer saat aplikasi berada di latar belakang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni Erhu aperta durante l’invio: iOS mette in pausa il trasferimento quando l’app è in background."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd Erhu open tijdens het versturen: iOS pauzeert de overdracht als de app op de achtergrond staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie zamykaj Erhu podczas wysyłania: iOS wstrzymuje przesyłanie, gdy aplikacja działa w tle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o Erhu aberto durante o envio: o iOS pausa a transferência quando o app está em segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не закрывайте Erhu во время отправки: iOS приостанавливает передачу, когда приложение в фоне."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gönderirken Erhu'yu açık tutun: uygulama arka plandayken iOS aktarımı duraklatır."
          }
        }
      }
    },
    "Keep both devices on this Wi-Fi until it finishes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass beide Geräte bis zum Ende in diesem WLAN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén ambos dispositivos en esta Wi-Fi hasta que termine."
          }
        },
        "fr" : {
