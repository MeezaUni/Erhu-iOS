        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این‌ها تطابق‌های تقریبی‌اند. ژانری امتحان کنید یا کمی جزئیات اضافه کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maluwag na tugma ang mga ito. Sumubok ng genre o magdagdag ng kaunting detalye."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce sont des correspondances approximatives. Essayez un genre ou ajoutez un peu de détails."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये ढीले मिलान हैं। कोई शैली आज़माएँ या थोड़ा और विवरण जोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini kecocokan longgar. Coba genre atau tambahkan sedikit detail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono corrispondenze approssimative. Prova un genere o aggiungi qualche dettaglio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゆるい一致結果です。ジャンルを試すか、もう少し詳しく入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "느슨한 일치 결과입니다. 장르를 시도하거나 조금 더 자세히 적어 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit zijn losse treffers. Probeer een genre of voeg wat meer details toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To luźne dopasowania. Spróbuj gatunku albo dodaj trochę szczegółów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "São correspondências aproximadas. Tente um gênero ou adicione mais detalhes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это приблизительные совпадения. Попробуйте жанр или добавьте немного подробностей."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இவை தளர்வான பொருத்தங்கள். ஒரு வகையை முயலவும் அல்லது சற்று விவரம் சேர்க்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇవి వదులైన సరిపోలికలు. ఒక శైలిని ప్రయత్నించండి లేదా కొంచెం వివరం జోడించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นี่เป็นผลที่ตรงกันแบบหลวมๆ ลองใส่แนวเพลงหรือเพิ่มรายละเอียดอีกนิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunlar gevşek eşleşmeler. Bir tür deneyin ya da biraz daha ayrıntı ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це приблизні збіги. Спробуйте жанр або додайте трохи подробиць."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ ڈھیلے نتائج ہیں۔ کوئی صنف آزمائیں یا تھوڑی مزید تفصیل دیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây là các kết quả gần đúng. Hãy thử một thể loại hoặc thêm chút chi tiết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些是宽松匹配。试试某个类型，或多加一点细节。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些是寬鬆匹配。試試某個類型，或多加一點細節。"
          }
