          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте хотя бы два трека, чтобы настроить переходы между ними."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "டிராக்குகளுக்கு இடையே மாற்றங்களை அமைக்க குறைந்தது இரண்டு டிராக்குகளைச் சேர்க்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
