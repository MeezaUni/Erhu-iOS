            "value" : "IPA को SideStore या AltStore से इंस्टॉल करें। Erhu खुद को इंस्टॉल नहीं कर सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasang IPA menggunakan SideStore atau AltStore. Erhu tidak bisa memasang dirinya sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installa l’IPA con SideStore o AltStore. Erhu non può installarsi da solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SideStore または AltStore で IPA をインストールしてください。Erhu は自分自身をインストールできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SideStore 또는 AltStore로 IPA를 설치하세요. Erhu는 스스로 설치할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installeer de IPA met SideStore of AltStore. Erhu kan zichzelf niet installeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zainstaluj plik IPA przez SideStore lub AltStore. Erhu nie może zainstalować się samo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instale o IPA com o SideStore ou o AltStore. O Erhu não consegue se instalar sozinho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установите IPA через SideStore или AltStore. Erhu не может установить себя сам."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SideStore அல்லது AltStore மூலம் IPA ஐ நிறுவவும். Erhu தன்னைத்தானே நிறுவ முடியாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SideStore లేదా AltStore ఉపయోగించి IPA ని ఇన్‌స్టాల్ చేయండి. Erhu తనను తాను ఇన్‌స్టాల్ చేసుకోలేదు."
