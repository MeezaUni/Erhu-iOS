    "Privacy" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prywatność"
          }
        }
      }
    },
    "Privacy: the page works only on your local network, only while this screen shows it as on, and only with this session's code. It uses plain HTTP, so on a shared or untrusted Wi-Fi others on the network could see what is sent." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prywatność: strona działa tylko w sieci lokalnej, tylko gdy ten ekran pokazuje ją jako włączoną, i tylko z kodem tej sesji. Używa zwykłego HTTP, więc w udostępnionej lub niezaufanej sieci Wi-Fi inni mogą zobaczyć, co jest wysyłane."
          }
        }
      }
    },
