    "Add at least two tracks to set up transitions between them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف مقطعين على الأقل لإعداد الانتقالات بينهما."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ট্রানজিশন সেট করতে অন্তত দুটি ট্র্যাক যোগ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge mindestens zwei Titel hinzu, um Übergänge zwischen ihnen einzurichten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade al menos dos pistas para configurar transiciones entre ellas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای تنظیم گذار بین آهنگ‌ها، دست‌کم دو آهنگ اضافه کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magdagdag ng kahit dalawang track para makapag-set up ng transition sa pagitan nila."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez au moins deux morceaux pour configurer des transitions entre eux."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रांज़िशन सेट करने के लिए कम से कम दो ट्रैक जोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan setidaknya dua trek untuk mengatur transisi di antaranya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi almeno due brani per impostare le transizioni tra loro."
          }
        },
        "ja" : {
          "stringUnit" : {
