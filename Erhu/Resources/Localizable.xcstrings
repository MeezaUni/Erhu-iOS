    "This is a widget skin, not a colour theme. Skins aren't used on iOS." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا مظهر أداة، وليس سمة ألوان. لا تُستخدم المظاهر على iOS."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি উইজেট স্কিন, রঙের থিম নয়। iOS-এ স্কিন ব্যবহার হয় না।"
          }
        },
        "de" : {
