        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple-এর ওয়েব প্লেয়ার বদলে গেছে; অ্যানিমেটেড কভার খোঁজা যাচ্ছে না।"
          }
        },
        "de" : {
          "stringUnit" : {
