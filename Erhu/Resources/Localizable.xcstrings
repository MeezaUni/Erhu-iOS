            "state" : "translated",
            "value" : "Widget skin ito, hindi color theme. Hindi ginagamit ang mga skin sa iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est un habillage de widget, pas un thème de couleurs. Les habillages ne sont pas utilisés sur iOS."
