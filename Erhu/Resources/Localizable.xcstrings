    "Download stopped. Covers saved: %lld. Download all resumes the remaining covers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download gestoppt. Gespeicherte Cover: %lld. „Alle laden“ setzt die verbleibenden Cover fort."
          }
        },
        "es" : {
          "stringUnit" : {
