          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una casa per la musica che possiedi. La tua raccolta e la cronologia di ascolto restano su questo iPhone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een thuis voor de muziek die van jou is. Je collectie en luistergeschiedenis blijven op deze iPhone."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dom dla muzyki, którą posiadasz. Twoja kolekcja i historia słuchania zostają na tym iPhonie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um lar para a música que você tem. Sua coleção e seu histórico de audição ficam neste iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дом для музыки, которой вы владеете. Ваша коллекция и история прослушивания остаются на этом iPhone."
