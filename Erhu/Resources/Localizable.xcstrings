    "Confirm this is the same image before replacing it. Other tags stay unchanged. Saved artwork fits within %lld pixels." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأكد من أنها الصورة نفسها قبل استبدالها. لا تتغير الوسوم الأخرى. تتسع الصورة المحفوظة ضمن %lld بكسل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বদলানোর আগে নিশ্চিত করুন এটি একই ছবি। অন্যান্য ট্যাগ অপরিবর্তিত থাকে। সংরক্ষিত আর্টওয়ার্ক %lld পিক্সেলের মধ্যে থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätige, dass es dasselbe Bild ist, bevor du es ersetzt. Andere Tags bleiben unverändert. Gespeicherte Cover passen in %lld Pixel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirma que es la misma imagen antes de reemplazarla. Las demás etiquetas no cambian. La portada guardada cabe en %lld píxeles."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیش از جایگزینی، مطمئن شوید همان تصویر است. دیگر برچسب‌ها تغییر نمی‌کنند. تصویر ذخیره‌شده در %lld پیکسل جا می‌گیرد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiyaking ito rin ang larawan bago palitan. Hindi magbabago ang ibang tag. Kasya sa %lld pixel ang naka-save na artwork."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmez qu’il s’agit de la même image avant de la remplacer. Les autres tags ne changent pas. La pochette enregistrée tient dans %lld pixels."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बदलने से पहले पक्का करें कि यह वही छवि है। दूसरे टैग नहीं बदलेंगे। सहेजा गया आर्टवर्क %lld पिक्सेल में आता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastikan ini gambar yang sama sebelum menggantinya. Tag lain tidak berubah. Sampul yang disimpan muat dalam %lld piksel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conferma che è la stessa immagine prima di sostituirla. Gli altri tag non cambiano. La copertina salvata rientra in %lld pixel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "置き換える前に同じ画像であることを確認してください。他のタグは変わりません。保存されるアートワークは %lld ピクセル以内に収まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바꾸기 전에 같은 이미지인지 확인하세요. 다른 태그는 바뀌지 않습니다. 저장되는 아트워크는 %lld 픽셀 이내입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevestig dat het dezelfde afbeelding is voordat je hem vervangt. Andere tags blijven ongewijzigd. De bewaarde hoes past binnen %lld pixels."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potwierdź, że to ten sam obraz, zanim go zastąpisz. Inne tagi pozostaną bez zmian. Zapisana okładka mieści się w %lld pikselach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirme que é a mesma imagem antes de substituí-la. As outras tags não mudam. A capa salva cabe em %lld pixels."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убедитесь, что это то же изображение, прежде чем заменить его. Остальные теги не меняются. Сохранённая обложка помещается в %lld пикселей."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மாற்றுவதற்கு முன் இது அதே படம் என உறுதிப்படுத்தவும். பிற குறிச்சொற்கள் மாறாது. சேமித்த கலைப்படம் %lld பிக்சல்களுக்குள் இருக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మార్చే ముందు ఇది అదే చిత్రమని నిర్ధారించండి. ఇతర ట్యాగ్‌లు మారవు. సేవ్ చేసిన ఆర్ట్‌వర్క్ %lld పిక్సెల్‌లలో సరిపోతుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยืนยันว่าเป็นภาพเดียวกันก่อนแทนที่ แท็กอื่นไม่เปลี่ยน ภาพปกที่บันทึกมีขนาดไม่เกิน %lld พิกเซล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değiştirmeden önce aynı görsel olduğunu onaylayın. Diğer etiketler değişmez. Kaydedilen kapak %lld pikselin içine sığar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перш ніж замінювати, переконайтеся, що це те саме зображення. Інші теги не зміняться. Збережена обкладинка вміщується в %lld пікселів."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدلنے سے پہلے تصدیق کریں کہ یہ وہی تصویر ہے۔ دیگر ٹیگز نہیں بدلتے۔ محفوظ آرٹ ورک %lld پکسل کے اندر رہتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xác nhận đây là cùng một ảnh trước khi thay. Các thẻ khác giữ nguyên. Ảnh bìa đã lưu nằm trong %lld điểm ảnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "替换前请确认是同一张图片。其他标签保持不变。保存的插图不超过 %lld 像素。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "替換前請確認是同一張圖片。其他標籤保持不變。儲存的插圖不超過 %lld 畫素。"
          }
        }
      }
    },
    "Connect the phone to the same Wi-Fi as your computer, then start again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صِل الهاتف بشبكة Wi-Fi نفسها التي عليها حاسوبك، ثم ابدأ من جديد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফোনকে কম্পিউটারের একই ওয়াই-ফাইতে যুক্ত করে আবার শুরু করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde das Telefon mit demselben WLAN wie deinen Computer und starte dann neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta el teléfono a la misma Wi-Fi que tu ordenador y vuelve a empezar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گوشی را به همان Wi-Fi رایانه‌تان وصل کنید، سپس دوباره شروع کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikonekta ang telepono sa parehong Wi-Fi ng computer mo, saka simulang muli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez le téléphone au même Wi-Fi que votre ordinateur, puis recommencez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोन को उसी Wi-Fi से जोड़ें जिस पर आपका कंप्यूटर है, फिर दोबारा शुरू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungkan ponsel ke Wi-Fi yang sama dengan komputer Anda, lalu mulai lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega il telefono alla stessa rete Wi-Fi del computer, poi ricomincia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端末をコンピュータと同じWi-Fiに接続してから、もう一度始めてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰을 컴퓨터와 같은 Wi-Fi에 연결한 다음 다시 시작하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbind de telefoon met dezelfde wifi als je computer en begin opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połącz telefon z tą samą siecią Wi-Fi co komputer i zacznij ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte o telefone ao mesmo Wi-Fi do computador e comece de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите телефон к той же сети Wi-Fi, что и компьютер, и начните заново."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் கணினி உள்ள அதே Wi-Fi இல் தொலைபேசியை இணைத்து, மீண்டும் தொடங்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ కంప్యూటర్ ఉన్న అదే Wi-Fi కి ఫోన్‌ను కనెక్ట్ చేసి, మళ్ళీ ప్రారంభించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อโทรศัพท์กับ Wi-Fi เดียวกับคอมพิวเตอร์ แล้วเริ่มใหม่"
