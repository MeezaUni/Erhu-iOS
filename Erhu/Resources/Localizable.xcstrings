        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS इस डिवाइस पर एनिमेटेड कवर स्वीकार नहीं कर रहा है।"
          }
        },
        "id" : {
          "stringUnit" : {
