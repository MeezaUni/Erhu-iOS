        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สำเนาแบบอ่านอย่างเดียวสำหรับภาพแสดงเสียงและมาตรวัดพีกด้านล่าง ไม่เปลี่ยนเสียงเลย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görselleştirici ve aşağıdaki tepe ölçer için salt okunur kopya; sesi asla değiştirmez"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копія лише для читання для візуалізатора й індикатора піків нижче; ніколи не змінює аудіо"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نیچے ویژولائزر اور پیک میٹر کے لیے صرف پڑھنے کی کاپی؛ آڈیو کو کبھی نہیں بدلتی"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản sao chỉ đọc cho trình hiển thị và đồng hồ đỉnh bên dưới; không bao giờ đổi âm thanh"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
