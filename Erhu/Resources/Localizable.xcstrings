    "GitHub is rate-limiting requests. Try again after %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحدّ GitHub من الطلبات. حاول مرة أخرى بعد %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub অনুরোধ সীমিত করছে। %@-এর পরে আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
