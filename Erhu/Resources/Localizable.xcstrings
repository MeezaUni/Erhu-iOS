        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "செயலாக்க அலகுகளை ஏற்ற முடியவில்லை; அவை இல்லாமல் ஆடியோ இயங்குகிறது"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ప్రాసెసింగ్ యూనిట్‌లను లోడ్ చేయలేకపోయాం; అవి లేకుండా ఆడియో ప్లే అవుతోంది"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โหลดหน่วยประมวลผลไม่ได้ เสียงจะเล่นโดยไม่มีหน่วยเหล่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşleme birimleri yüklenemedi; ses onlarsız çalıyor"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося завантажити модулі обробки; аудіо відтворюється без них"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پروسیسنگ یونٹس لوڈ نہ ہو سکے؛ آڈیو ان کے بغیر چلتی ہے"
          }
        },
        "vi" : {
