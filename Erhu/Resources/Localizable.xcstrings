          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صرف تب سطحیں بدلتا ہے جب ٹرانزیشن اسٹوڈیو میں ترتیب دی گئی ٹرانزیشن چل رہی ہو"
          }
        },
        "vi" : {
