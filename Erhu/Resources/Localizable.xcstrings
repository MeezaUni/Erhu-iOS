    "Adjust to move the view without moving either cue." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضبط لتحريك العرض دون تحريك أي نقطة إشارة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো কিউ না সরিয়ে ভিউ সরাতে সামঞ্জস্য করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändert die Ansicht, ohne einen Cue-Punkt zu verschieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta para mover la vista sin mover ningún punto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای جابه‌جایی نما بدون جابه‌جا کردن هیچ نقطه‌ای تنظیم کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-adjust para ilipat ang view nang hindi ginagalaw ang alinmang cue."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplace la vue sans déplacer les repères."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्यू पॉइंट हिलाए बिना व्यू को खिसकाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menggeser tampilan tanpa memindahkan cue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta la vista senza spostare i cue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どちらのキューも動かさずに表示を移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어느 큐도 움직이지 않고 보기를 이동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschuift de weergave zonder cuepunten te verplaatsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń widok bez przesuwania punktów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta a visualização sem mover os pontos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сдвигает вид, не двигая метки."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "எந்த க்யூவையும் நகர்த்தாமல் பார்வையை நகர்த்தச் சரிசெய்யவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఏ క్యూనూ కదల్చకుండా వీక్షణను కదల్చడానికి సర్దుబాటు చేయండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปรับเพื่อเลื่อนมุมมองโดยไม่ขยับจุดคิวใด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşaretleri taşımadan görünümü kaydırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зсуньте вигляд, не переміщуючи жодної точки cue."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کسی بھی کیو کو ہلائے بغیر منظر کو منتقل کرنے کے لیے ایڈجسٹ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di chuyển khung nhìn mà không dời điểm cue nào."
          }
        },
        "zh-Hans" : {
