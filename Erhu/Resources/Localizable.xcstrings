    "Video supplied to iOS. The system controls whether it animates." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سُلِّم الفيديو إلى iOS. يقرر النظام ما إذا كان سيتحرك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভিডিও iOS-কে দেওয়া হয়েছে। এটি অ্যানিমেট হবে কিনা সিস্টেম নিয়ন্ত্রণ করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An iOS übergebenes Video. Das System entscheidet, ob es animiert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vídeo enviado a iOS. El sistema decide si se anima."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ویدیو به iOS داده شد. سیستم تعیین می‌کند که متحرک شود یا نه."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naibigay na sa iOS ang video. Ang system ang nagpapasya kung gagalaw ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vidéo fournie à iOS. Le système décide si elle s’anime."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS को दिया गया वीडियो। यह एनिमेट होगा या नहीं, सिस्टम तय करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video diberikan ke iOS. Sistem yang menentukan apakah video dianimasikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video fornito a iOS. Il sistema decide se animarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画を iOS に渡しました。アニメーションするかどうかはシステムが制御します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동영상을 iOS에 전달했습니다. 애니메이션 여부는 시스템이 결정합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video aan iOS gegeven. Het systeem bepaalt of hij beweegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Film przekazany do iOS. System decyduje, czy będzie animowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vídeo entregue ao iOS. O sistema decide se ele é animado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видео передано в iOS. Система решает, будет ли оно анимироваться."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வீடியோ iOS க்கு வழங்கப்பட்டது. இது அசையுமா என்பதைக் கணினி கட்டுப்படுத்தும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "వీడియో iOS కు అందించబడింది. అది యానిమేట్ అవ్వాలా వద్దా అనేది సిస్టమ్ నియంత్రిస్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งวิดีโอให้ iOS แล้ว ระบบเป็นผู้ควบคุมว่าจะเคลื่อนไหวหรือไม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS’a verilen video. Hareket edip etmeyeceğine sistem karar verir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відео передано iOS. Система вирішує, чи анімувати його."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ویڈیو iOS کو فراہم کی گئی۔ یہ متحرک ہو یا نہیں، سسٹم طے کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video đã chuyển cho iOS. Hệ thống quyết định có tạo hoạt ảnh hay không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视频已提供给 iOS。是否播放动画由系统控制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影片已提供給 iOS。是否播放動畫由系統控制。"
          }
        }
      }
    },
