    "Throwback uses your songs’ year tags: released %lld or more years ago." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم «حنين» وسوم السنة في أغانيك: صدرت قبل %lld سنة أو أكثر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পুরোনো দিনের গান আপনার গানের বছরের ট্যাগ ব্যবহার করে: %lld বা তার বেশি বছর আগে প্রকাশিত।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeitreise nutzt die Jahres-Tags deiner Titel: vor %lld oder mehr Jahren erschienen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostalgia usa las etiquetas de año de tus canciones: publicadas hace %lld años o más."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«نوستالژی» از برچسب سال آهنگ‌هایتان استفاده می‌کند: منتشرشده %lld سال پیش یا بیشتر."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumagamit ang Throwback ng mga tag ng taon ng mga kanta mo: inilabas %lld o higit pang taon na ang nakalipas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rétro utilise les tags d’année de vos morceaux : sortis il y a %lld ans ou plus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुरानी यादें आपके गानों के साल वाले टैग इस्तेमाल करती है: %lld या उससे ज़्यादा साल पहले रिलीज़ हुए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostalgia memakai tag tahun lagu Anda: dirilis %lld tahun lalu atau lebih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostalgia usa i tag dell’anno dei tuoi brani: usciti %lld o più anni fa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "懐かしの曲は曲の年タグを使います：%lld年以上前にリリースされた曲です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추억의 노래는 노래의 연도 태그를 사용합니다: %lld년 이상 전에 발매된 곡."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terugblik gebruikt de jaartags van je nummers: %lld of meer jaar geleden uitgebracht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powrót do przeszłości korzysta z tagów roku: wydane %lld lub więcej lat temu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostalgia usa as tags de ano das suas músicas: lançadas há %lld anos ou mais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ностальгия» использует теги года: выпущено %lld или более лет назад."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“பழைய நினைவுகள்” உங்கள் பாடல்களின் ஆண்டுக் குறிச்சொற்களைப் பயன்படுத்துகிறது: %lld அல்லது அதற்கு மேற்பட்ட ஆண்டுகளுக்கு முன் வெளியானவை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“పాత జ్ఞాపకాలు” మీ పాటల సంవత్సర ట్యాగ్‌లను ఉపయోగిస్తుంది: %lld లేదా అంతకంటే ఎక్కువ సంవత్సరాల క్రితం విడుదలైనవి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ย้อนวันวานใช้แท็กปีของเพลง: ออกเมื่อ %lld ปีขึ้นไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostalji şarkılarınızın yıl etiketlerini kullanır: %lld veya daha fazla yıl önce çıkanlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ностальгія» використовує теги року ваших пісень: видані %lld або більше років тому."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“پرانی یادیں” آپ کے گانوں کے سال کے ٹیگز استعمال کرتا ہے: %lld یا اس سے زیادہ سال پہلے ریلیز شدہ۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoài niệm dùng thẻ năm của bài hát: phát hành cách đây %lld năm trở lên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“怀旧”使用歌曲的年份标签：发行于 %lld 年或更久以前。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「懷舊」使用歌曲的年份標籤：發行於 %lld 年或更久以前。"
          }
        }
      }
    },
