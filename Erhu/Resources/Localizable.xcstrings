            "value" : "زمان‌بندی ذخیره نشد. فضای موجود را بررسی و دوباره امتحان کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi ma-save ang timing. Suriin ang available na storage at subukang muli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’enregistrer la synchronisation. Vérifiez l’espace disponible et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टाइमिंग सहेजी नहीं जा सकी। उपलब्ध स्टोरेज जाँचें और फिर कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat menyimpan pengaturan waktu. Periksa ruang penyimpanan dan coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvare la sincronizzazione. Controlla lo spazio disponibile e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイミングを保存できませんでした。空き容量を確認してもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이밍을 저장할 수 없습니다. 사용 가능한 저장 공간을 확인하고 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de timing niet bewaren. Controleer de vrije opslag en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zapisać synchronizacji. Sprawdź wolne miejsce i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível salvar a sincronização. Verifique o armazenamento disponível e tente de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить синхронизацию. Проверьте свободное место и повторите."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நேர அமைப்பைச் சேமிக்க முடியவில்லை. கிடைக்கும் சேமிப்பகத்தைச் சரிபார்த்து மீண்டும் முயலவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సమయాన్ని సేవ్ చేయలేకపోయాము. అందుబాటులో ఉన్న నిల్వను తనిఖీ చేసి మళ్ళీ ప్రయత్నించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกจังหวะเวลาไม่ได้ ตรวจพื้นที่ว่างแล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamanlama kaydedilemedi. Boş alanı denetleyip yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося зберегти синхронізацію. Перевірте вільне місце й спробуйте знову."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ٹائمنگ محفوظ نہ ہو سکی۔ دستیاب اسٹوریج چیک کر کے دوبارہ کوشش کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không lưu được thời gian. Hãy kiểm tra dung lượng trống rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保存时间调整。请检查可用存储空间后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法儲存時間調整。請檢查可用儲存空間後重試。"
          }
        }
      }
    },
