    "Online lyrics are temporarily unavailable. You can search the web instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كلمات الأغاني عبر الإنترنت غير متاحة مؤقتًا. يمكنك البحث على الويب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অনলাইন গানের কথা সাময়িকভাবে পাওয়া যাচ্ছে না। আপনি ওয়েবে খুঁজতে পারেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Online-Songtexte sind vorübergehend nicht verfügbar. Du kannst stattdessen im Web suchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las letras en línea no están disponibles por ahora. Puedes buscar en la web."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متن ترانهٔ آنلاین موقتاً در دسترس نیست. می‌توانید در وب جست‌وجو کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pansamantalang hindi available ang lyrics online. Maaari kang maghanap sa web."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paroles en ligne sont momentanément indisponibles. Vous pouvez chercher sur le web."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑनलाइन बोल अभी उपलब्ध नहीं हैं। आप वेब पर खोज सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lirik online sedang tidak tersedia. Anda dapat mencarinya di web."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I testi online non sono momentaneamente disponibili. Puoi cercare sul web."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンラインの歌詞は一時的に利用できません。代わりにWebで検索できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "온라인 가사를 일시적으로 사용할 수 없습니다. 대신 웹에서 검색할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Online songteksten zijn tijdelijk niet beschikbaar. Je kunt in plaats daarvan op het web zoeken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teksty online są chwilowo niedostępne. Możesz zamiast tego poszukać w internecie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As letras online estão temporariamente indisponíveis. Você pode buscar na web."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тексты из сети временно недоступны. Можно поискать в интернете."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இணையப் பாடல் வரிகள் தற்காலிகமாகக் கிடைக்கவில்லை. நீங்கள் இணையத்தில் தேடலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఆన్‌లైన్ సాహిత్యం తాత్కాలికంగా అందుబాటులో లేదు. మీరు వెబ్‌లో శోధించవచ్చు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เนื้อเพลงออนไลน์ใช้ไม่ได้ชั่วคราว คุณค้นหาบนเว็บแทนได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevrimiçi şarkı sözleri geçici olarak kullanılamıyor. Bunun yerine web'de arayabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тексти з мережі тимчасово недоступні. Можна пошукати в інтернеті."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آن لائن بول عارضی طور پر دستیاب نہیں۔ آپ ویب پر تلاش کر سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lời trực tuyến tạm thời không có. Bạn có thể tìm trên web."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在线歌词暂时不可用。你可以改为在网上搜索。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "線上歌詞暫時不可用。你可以改為在網上搜尋。"
          }
        }
      }
    },
    "Only %lld of %lld sections had a dependable beat (about %lld BPM)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld فقط من %2$lld أجزاء كان فيها نبض موثوق (نحو %3$lld BPM)"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lldটি অংশের মধ্যে কেবল %1$lldটিতে নির্ভরযোগ্য বিট ছিল (প্রায় %3$lld BPM)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur %lld von %lld Abschnitten hatten einen verlässlichen Beat (etwa %lld BPM)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo %lld de %lld secciones tenían un ritmo fiable (unos %lld BPM)"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط %1$lld از %2$lld بخش ضرب قابل اعتماد داشتند (حدود %3$lld BPM)"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld lang sa %lld na bahagi ang may maaasahang beat (mga %lld BPM)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules %lld sections sur %lld avaient un rythme fiable (environ %lld BPM)"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld में से केवल %1$lld हिस्सों में भरोसेमंद बीट थी (लगभग %3$lld BPM)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya %lld dari %lld bagian yang punya ketukan andal (sekitar %lld BPM)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo %lld sezioni su %lld avevano un ritmo affidabile (circa %lld BPM)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信頼できるビートがあったのは%2$lld区間中%1$lld区間だけです（約%3$lld BPM）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld개 구간 중 %1$lld개 구간만 비트가 믿을 만했습니다(약 %3$lld BPM)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slechts %lld van %lld delen hadden een betrouwbare beat (ongeveer %lld BPM)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko %lld z %lld fragmentów miało pewny rytm (około %lld BPM)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só %lld de %lld trechos tinham uma batida confiável (cerca de %lld BPM)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надёжный ритм был лишь в %lld из %lld фрагментов (около %lld BPM)"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld பகுதிகளில் %1$lld மட்டுமே நம்பகமான தாளம் கொண்டிருந்தன (சுமார் %3$lld BPM)"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld భాగాలలో %1$lld మాత్రమే నమ్మదగిన బీట్ కలిగి ఉన్నాయి (సుమారు %3$lld BPM)"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีเพียง %1$lld จาก %2$lld ช่วงที่มีจังหวะเชื่อถือได้ (ประมาณ %3$lld BPM)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld bölümün yalnızca %1$lld tanesinde güvenilir ritim vardı (yaklaşık %3$lld BPM)"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надійний ритм мали лише %lld з %lld фрагментів (близько %lld BPM)"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld میں سے صرف %1$lld حصوں میں قابل اعتماد بیٹ تھی (تقریباً %3$lld BPM)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ %lld trong %lld đoạn có nhịp đáng tin (khoảng %lld BPM)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld 个段落中只有 %1$lld 个有可靠节拍（约 %3$lld BPM）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld 個段落中只有 %1$lld 個有可靠節拍（約 %3$lld BPM）"
          }
        }
      }
    },
    "Only complete motion-cover clips can be downloaded." : {
      "localizations" : {
