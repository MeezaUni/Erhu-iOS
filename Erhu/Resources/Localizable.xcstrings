    "Master switch for every transition in the app. Off keeps all settings but plays tracks back to back." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المفتاح الرئيسي لكل انتقال في التطبيق. يحتفظ الإيقاف بكل الإعدادات لكنه يشغّل المقاطع متتالية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপের প্রতিটি ট্রানজিশনের মাস্টার সুইচ। বন্ধ করলে সব সেটিংস থাকে কিন্তু ট্র্যাক পরপর বাজে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hauptschalter für alle Übergänge der App. „Aus“ behält alle Einstellungen, spielt Titel aber direkt hintereinander."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interruptor general de todas las transiciones de la app. Desactivado conserva los ajustes pero reproduce las pistas seguidas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کلید اصلی همه گذارهای برنامه. خاموش کردن همه تنظیمات را نگه می‌دارد اما آهنگ‌ها را پشت‌سرهم پخش می‌کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Master switch para sa bawat transition sa app. Kapag naka-off, mananatili ang lahat ng setting pero sunud-sunod na tutugtog ang mga track."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrupteur principal de toutes les transitions de l’app. Désactivé conserve les réglages mais enchaîne les morceaux sans fondu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप के हर ट्रांज़िशन का मुख्य स्विच। बंद करने पर सारी सेटिंग रहती हैं, पर ट्रैक एक के बाद एक सीधे बजते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sakelar utama untuk setiap transisi di aplikasi. Nonaktif menyimpan semua pengaturan tetapi memutar trek berurutan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interruttore principale di tutte le transizioni dell’app. Disattivato mantiene le impostazioni ma riproduce i brani uno dopo l’altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ内のすべてのトランジションのマスタースイッチです。オフにすると設定はすべて保持したまま、曲を続けて再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱의 모든 트랜지션에 대한 마스터 스위치입니다. 끄면 설정은 모두 유지하고 곡을 연달아 재생합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoofdschakelaar voor elke overgang in de app. Uit behoudt alle instellingen maar speelt nummers direct na elkaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Główny przełącznik wszystkich przejść w aplikacji. Wyłączony zachowuje ustawienia, ale odtwarza utwory jeden po drugim."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chave principal de todas as transições do app. Desativada mantém todos os ajustes, mas toca as faixas uma após a outra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Главный переключатель всех переходов приложения. «Выкл.» сохраняет настройки, но проигрывает треки подряд."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பயன்பாட்டின் ஒவ்வொரு மாற்றத்துக்குமான முதன்மை சுவிட்ச். முடக்கினால் எல்லா அமைப்புகளும் இருக்கும், ஆனால் டிராக்குகள் தொடர்ச்சியாக இயங்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "యాప్‌లోని ప్రతి ట్రాన్సిషన్‌కూ మాస్టర్ స్విచ్. ఆఫ్ చేస్తే అన్ని సెట్టింగ్‌లు ఉంటాయి కానీ ట్రాక్‌లు వరుసగా ప్లే అవుతాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สวิตช์หลักสำหรับทุกการเปลี่ยนผ่านในแอป “ปิด” จะคงการตั้งค่าทั้งหมดแต่เล่นแทร็กต่อกันทันที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamadaki tüm geçişlerin ana anahtarı. Kapalı, tüm ayarları korur ama parçaları art arda çalar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Головний перемикач для всіх переходів у програмі. «Вимк.» зберігає всі налаштування, але відтворює треки один за одним."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایپ کی ہر ٹرانزیشن کا ماسٹر سوئچ۔ بند کرنے پر تمام ترتیبات برقرار رہتی ہیں لیکن ٹریکس ایک کے بعد ایک چلتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Công tắc chính cho mọi chuyển tiếp trong ứng dụng. Tắt sẽ giữ cài đặt nhưng phát các bài nối tiếp nhau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用中所有过渡的总开关。关闭后保留所有设置，但曲目将连续播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "應用中所有過渡的總開關。關閉後保留所有設定，但曲目將連續播放。"
          }
        }
      }
    },
