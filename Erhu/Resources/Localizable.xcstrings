        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ entièrement réparés ; %lld à vérifier encore. Les réparations incomplètes n’ont pas été écrites."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरी तरह ठीक: %@; %lld की अब भी समीक्षा चाहिए। अधूरे सुधार लिखे नहीं गए।"
