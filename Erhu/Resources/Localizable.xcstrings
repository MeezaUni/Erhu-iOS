    "Too many wrong codes. Scan the QR code, or stop and start the transfer on the phone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رموز خاطئة كثيرة. امسح رمز QR، أو أوقف النقل على الهاتف وابدأه من جديد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অনেকবার ভুল কোড। QR কোড স্ক্যান করুন, বা ফোনে ট্রান্সফার থামিয়ে আবার শুরু করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viele falsche Codes. Scanne den QR-Code oder stoppe und starte die Übertragung auf dem Telefon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiados códigos incorrectos. Escanea el código QR o detén e inicia la transferencia en el teléfono."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کدهای نادرست زیادی. کد QR را اسکن کنید، یا انتقال را در گوشی متوقف و دوباره شروع کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masyadong maraming maling code. I-scan ang QR code, o ihinto at simulang muli ang transfer sa telepono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de codes incorrects. Scannez le code QR, ou arrêtez et relancez le transfert sur le téléphone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बहुत ज़्यादा गलत कोड। QR कोड स्कैन करें, या फ़ोन पर ट्रांसफ़र रोककर फिर शुरू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
