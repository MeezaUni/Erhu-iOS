    "Pick the right one to write it, with the fields chosen on the Fix tags page. The original is kept for Revert." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر المطابقة الصحيحة لكتابتها، مع الحقول المختارة في صفحة إصلاح الوسوم. تُحفظ النسخة الأصلية للتراجع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লেখার জন্য সঠিকটি বেছে নিন, “ট্যাগ ঠিক করুন” পৃষ্ঠায় বেছে নেওয়া ফিল্ডসহ। ফিরিয়ে আনার জন্য মূল কপি রাখা হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle den richtigen, um ihn mit den auf der Seite „Tags korrigieren“ gewählten Feldern zu schreiben. Das Original bleibt zum Wiederherstellen erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la correcta para escribirla, con los campos elegidos en la página Corregir etiquetas. El original se conserva para Revertir."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گزینه درست را برای نوشتن انتخاب کنید، با فیلدهایی که در صفحه اصلاح برچسب‌ها انتخاب شده‌اند. نسخه اصلی برای برگرداندن نگه داشته می‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin ang tamang isusulat, gamit ang mga field na pinili sa pahina ng Ayusin ang tag. Itinatago ang orihinal para sa Ibalik."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez la bonne pour l’écrire, avec les champs choisis sur la page Corriger les tags. L’original est conservé pour Rétablir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सही वाला चुनें ताकि वह टैग ठीक करें पेज पर चुने गए फ़ील्ड के साथ लिखा जाए। मूल फ़ाइल पलटने के लिए रखी जाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih yang benar untuk menulisnya, dengan kolom yang dipilih di halaman Perbaiki tag. File asli disimpan untuk Kembalikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli quella giusta per scriverla con i campi scelti nella pagina Correggi tag. L’originale resta conservato per il ripristino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書き込む候補を選んでください。「タグを修正」ページで選んだ項目が書き込まれます。元データは「元に戻す」用に保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록할 항목을 고르세요. 태그 수정 페이지에서 선택한 항목이 기록됩니다. 원본은 되돌리기용으로 보관됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies de juiste om hem te schrijven, met de velden die op de pagina Tags herstellen zijn gekozen. Het origineel blijft bewaard voor Terugdraaien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz właściwy, aby go zapisać, z polami wybranymi na stronie Popraw tagi. Oryginał zostaje zachowany do przywrócenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha a correta para gravá-la, com os campos escolhidos na página Corrigir tags. O original fica guardado para Reverter."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите нужное, чтобы записать его с полями, выбранными на странице «Исправить теги». Оригинал сохраняется для отмены."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "எழுதச் சரியானதைத் தேர்ந்தெடுக்கவும், “குறிச்சொற்களைச் சரிசெய்” பக்கத்தில் தேர்ந்தெடுத்த புலங்களுடன். திரும்பப் பெற மூலம் வைக்கப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "వ్రాయడానికి సరైనదాన్ని ఎంచుకోండి, “ట్యాగ్‌లు సరిచేయండి” పేజీలో ఎంచుకున్న ఫీల్డ్‌లతో. తిరిగి మార్చడానికి అసలు కాపీ ఉంచబడుతుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกผลที่ถูกต้องเพื่อเขียน พร้อมช่องที่เลือกในหน้าแก้แท็ก ต้นฉบับจะถูกเก็บไว้เพื่อย้อนกลับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fix tags sayfasında seçilen alanlarla yazmak için doğru olanı seçin. Orijinal Geri Al için saklanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть правильний варіант для запису з полями, вибраними на сторінці «Виправити теги». Оригінал зберігається для скасування."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لکھنے کے لیے صحیح نتیجہ چنیں، “ٹیگز درست کریں” صفحے پر چنی گئی فیلڈز کے ساتھ۔ اصل نسخہ واپسی کے لیے رکھا جاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn đúng kết quả để ghi, với các trường đã chọn ở trang Sửa thẻ. Bản gốc được giữ để Hoàn tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择要写入的正确结果，写入在“修复标签”页面选择的字段。原始版本会保留以便还原。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇要寫入的正確結果，寫入在「修復標籤」頁面選擇的欄位。原始版本會保留以便還原。"
          }
        }
      }
    },
