    "Mood matches use your songs’ genre and tempo tags." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم مطابقة المزاج وسوم النوع والإيقاع في أغانيك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মুড মেলাতে আপনার গানের ঘরানা ও টেম্পো ট্যাগ ব্যবহার হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimmungen nutzen die Genre- und Tempo-Tags deiner Titel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los estados de ánimo usan las etiquetas de género y tempo de tus canciones."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبیق حال‌وهوا از برچسب‌های سبک و تمپوی آهنگ‌هایتان استفاده می‌کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ginagamit ng pagtutugma ng mood ang mga tag ng genre at tempo ng mga kanta mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les ambiances utilisent les tags de genre et de tempo de vos morceaux."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मूड मिलान आपके गानों के शैली और टेम्पो टैग का इस्तेमाल करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencocokan suasana memakai tag genre dan tempo lagu Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli umori usano i tag di genere e tempo dei tuoi brani."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ムードの一致には曲のジャンルとテンポのタグを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분위기 매칭은 노래의 장르와 템포 태그를 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stemmingen gebruiken de genre- en tempotags van je nummers."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopasowanie nastroju korzysta z tagów gatunku i tempa twoich utworów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os climas usam as tags de gênero e andamento das suas músicas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подбор настроения использует теги жанра и темпа ваших треков."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மனநிலைப் பொருத்தங்கள் உங்கள் பாடல்களின் வகை மற்றும் டெம்போ குறிச்சொற்களைப் பயன்படுத்துகின்றன."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మూడ్ సరిపోలికలు మీ పాటల శైలి, టెంపో ట్యాగ్‌లను ఉపయోగిస్తాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การจับคู่อารมณ์ใช้แท็กแนวเพลงและจังหวะของเพลงคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruh hali eşleşmeleri şarkılarınızın tür ve tempo etiketlerini kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підбір за настроєм використовує теги жанру й темпу ваших пісень."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موڈ کے ملان آپ کے گانوں کی صنف اور ٹیمپو ٹیگز استعمال کرتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tâm trạng dựa vào thẻ thể loại và nhịp độ của bài hát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心情匹配使用歌曲的类型和速度标签。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心情匹配使用歌曲的類型和速度標籤。"
          }
        }
      }
    },
