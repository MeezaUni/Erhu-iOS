    "Check both devices use the same network (not a guest network: those often block devices from seeing each other)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق من أن الجهازين على الشبكة نفسها (وليست شبكة ضيوف: فهي غالبًا تمنع الأجهزة من رؤية بعضها)."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দেখুন দুটি ডিভাইস একই নেটওয়ার্কে আছে কিনা (গেস্ট নেটওয়ার্ক নয়: সেগুলো প্রায়ই ডিভাইসকে একে অপরকে দেখতে দেয় না)।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe, ob beide Geräte dasselbe Netzwerk nutzen (kein Gastnetz: Diese verhindern oft, dass sich Geräte sehen)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba que ambos dispositivos usan la misma red (no una red de invitados: suelen impedir que los dispositivos se vean)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بررسی کنید هر دو دستگاه روی یک شبکه‌اند (نه شبکهٔ مهمان: این شبکه‌ها اغلب نمی‌گذارند دستگاه‌ها یکدیگر را ببینند)."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiyaking nasa iisang network ang dalawang device (hindi guest network: madalas nitong pinipigilan ang mga device na makita ang isa't isa)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez que les deux appareils utilisent le même réseau (pas un réseau invité : ils empêchent souvent les appareils de se voir)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जाँचें कि दोनों डिवाइस एक ही नेटवर्क पर हैं (गेस्ट नेटवर्क नहीं: वे अक्सर डिवाइसों को एक-दूसरे को देखने नहीं देते)।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastikan kedua perangkat memakai jaringan yang sama (bukan jaringan tamu: jaringan itu sering mencegah perangkat saling melihat)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla che entrambi i dispositivi usino la stessa rete (non una rete ospiti: spesso impedisce ai dispositivi di vedersi)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方のデバイスが同じネットワークにあるか確認してください（ゲストネットワークは不可：デバイス同士が見えなくなることがよくあります）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 기기가 같은 네트워크를 쓰는지 확인하세요(게스트 네트워크는 안 됩니다. 기기끼리 서로 보지 못하게 막는 경우가 많습니다)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer of beide apparaten hetzelfde netwerk gebruiken (geen gastnetwerk: die laten apparaten elkaar vaak niet zien)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź, czy oba urządzenia są w tej samej sieci (nie w sieci gości: często blokuje ona wzajemną widoczność urządzeń)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confira se os dois dispositivos usam a mesma rede (não uma rede de convidados: elas costumam impedir que os dispositivos se vejam)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убедитесь, что оба устройства в одной сети (не гостевой: такие сети часто не дают устройствам видеть друг друга)."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இரண்டு சாதனங்களும் ஒரே பிணையத்தில் உள்ளனவா எனச் சரிபார்க்கவும் (விருந்தினர் பிணையம் அல்ல: அவை பெரும்பாலும் சாதனங்கள் ஒன்றையொன்று பார்க்க விடுவதில்லை)."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "రెండు పరికరాలు ఒకే నెట్‌వర్క్‌లో ఉన్నాయో తనిఖీ చేయండి (అతిథి నెట్‌వర్క్ కాదు: అవి తరచుగా పరికరాలు ఒకదానినొకటి చూడనివ్వవు)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจว่าอุปกรณ์ทั้งสองใช้เครือข่ายเดียวกัน (ไม่ใช่เครือข่ายผู้เยี่ยมชม ซึ่งมักกันไม่ให้อุปกรณ์มองเห็นกัน)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki cihazın da aynı ağı kullandığını denetleyin (misafir ağı değil: bunlar cihazların birbirini görmesini çoğu zaman engeller)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переконайтеся, що обидва пристрої в одній мережі (не гостьовій: такі мережі часто не дають пристроям бачити один одного)."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چیک کریں کہ دونوں ڈیوائسز ایک ہی نیٹ ورک پر ہیں (گیسٹ نیٹ ورک نہیں: وہ اکثر ڈیوائسز کو ایک دوسرے کو دیکھنے نہیں دیتے)۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra hai thiết bị dùng cùng mạng (không phải mạng khách: loại mạng này thường chặn các thiết bị nhìn thấy nhau)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查两台设备使用的是同一网络（不要用访客网络：这类网络常会阻止设备互相发现）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請檢查兩臺裝置使用的是同一網路（不要用訪客網路：這類網路常會阻止裝置互相發現）。"
          }
        }
      }
    },
