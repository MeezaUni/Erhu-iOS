    "Changes levels only while a transition set up in the Transition Studio plays" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يغيّر المستويات فقط أثناء تشغيل انتقال مُعَدّ في استوديو الانتقالات"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ট্রানজিশন স্টুডিওতে সেট করা ট্রানজিশন বাজার সময়ই কেবল লেভেল বদলায়"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändert Pegel nur, während ein im Übergangsstudio eingerichteter Übergang läuft"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia los niveles solo mientras suena una transición configurada en el Estudio de transiciones"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط هنگام پخش گذاری که در استودیوی گذار تنظیم شده، سطح‌ها را تغییر می‌دهد"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binabago lang ang level habang tumutugtog ang transition na na-set up sa Transition Studio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifie les niveaux uniquement pendant une transition configurée dans le Studio de transitions"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्तर सिर्फ़ तब बदलता है जब ट्रांज़िशन स्टूडियो में सेट किया गया ट्रांज़िशन बज रहा हो"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
