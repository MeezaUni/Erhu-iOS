        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile verificare i testi sincronizzati offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフラインのため同期歌詞を確認できませんでした。"
