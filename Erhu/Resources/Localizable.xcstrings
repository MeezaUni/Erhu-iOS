    "Selected from your library. Browse first, then choose what to play." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مختارة من مكتبتك. تصفّح أولًا، ثم اختر ما تريد تشغيله."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার লাইব্রেরি থেকে বেছে নেওয়া। আগে ব্রাউজ করুন, তারপর কী চালাবেন বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
