          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma forma de onda de origem não está disponível. Verifique se os dois arquivos de áudio podem ser lidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет исходной волновой формы. Проверьте, что оба аудиофайла читаются."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மூல அலைவடிவம் கிடைக்கவில்லை. இரு ஆடியோ கோப்புகளும் படிக்கக்கூடியவையா எனச் சரிபார்க்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సోర్స్ వేవ్‌ఫార్మ్ అందుబాటులో లేదు. రెండు ఆడియో ఫైళ్లూ చదవగలిగేలా ఉన్నాయో చూడండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีรูปคลื่นต้นฉบับ ตรวจสอบว่าไฟล์เสียงทั้งสองอ่านได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kaynak dalga biçimi yok. İki ses dosyasının da okunabildiğini kontrol edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хвильова форма джерела недоступна. Перевірте, що обидва аудіофайли можна прочитати."
          }
        },
