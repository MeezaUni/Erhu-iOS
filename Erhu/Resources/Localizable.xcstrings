    "Complete the remaining selected tags to save the whole repair together. Unknown fields keep this song in Needs review." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أكمل الوسوم المحددة المتبقية لحفظ الإصلاح كاملًا مرة واحدة. الحقول المجهولة تُبقي هذه الأغنية في «بحاجة إلى مراجعة»."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পুরো সংশোধন একসাথে সংরক্ষণ করতে বাকি নির্বাচিত ট্যাগ পূরণ করুন। অজানা ফিল্ড থাকলে এই গান “পর্যালোচনা দরকার”-এ থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ergänze die übrigen gewählten Tags, um die ganze Korrektur gemeinsam zu speichern. Unbekannte Felder lassen diesen Titel unter „Zu prüfen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completa las etiquetas seleccionadas que faltan para guardar toda la corrección a la vez. Los campos desconocidos dejan esta canción en Por revisar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای ذخیره کل اصلاح با هم، باقی برچسب‌های انتخاب‌شده را کامل کنید. فیلدهای نامعلوم این آهنگ را در «نیازمند بررسی» نگه می‌دارند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumpletuhin ang natitirang napiling tag para sabay na i-save ang buong pag-aayos. Dahil sa mga hindi alam na field, mananatili ang kantang ito sa Kailangang suriin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complétez les tags choisis restants pour enregistrer toute la correction en une fois. Les champs inconnus laissent ce morceau dans À vérifier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरा सुधार एक साथ सहेजने के लिए बाकी चुने गए टैग पूरे करें। अज्ञात फ़ील्ड इस गाने को “जाँच बाकी” में रखते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lengkapi tag terpilih yang tersisa untuk menyimpan seluruh perbaikan sekaligus. Kolom yang tidak diketahui membuat lagu ini tetap di Perlu ditinjau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completa i tag scelti rimanenti per salvare tutta la correzione insieme. I campi sconosciuti lasciano questo brano in Da rivedere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修正全体をまとめて保存するには、残りの選択タグを入力してください。不明な項目があるとこの曲は「要確認」に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나머지 선택한 태그를 완성하면 전체 수정을 한꺼번에 저장합니다. 알 수 없는 항목이 있으면 이 노래는 검토 필요에 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vul de overige gekozen tags aan om de hele herstelling in één keer te bewaren. Onbekende velden houden dit nummer in Te controleren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzupełnij pozostałe wybrane tagi, aby zapisać całą poprawkę naraz. Nieznane pola zostawiają ten utwór w Do sprawdzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complete as tags selecionadas restantes para salvar toda a correção de uma vez. Campos desconhecidos mantêm esta música em Para revisar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заполните оставшиеся выбранные теги, чтобы сохранить исправление целиком. Неизвестные поля оставляют трек в разделе «На проверку»."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "முழுத் திருத்தத்தையும் ஒன்றாகச் சேமிக்க மீதமுள்ள தேர்ந்தெடுத்த குறிச்சொற்களை நிரப்பவும். தெரியாத புலங்களால் இந்தப் பாடல் “மதிப்பாய்வு தேவை” இல் இருக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మొత్తం సరిచేతను ఒకేసారి సేవ్ చేయడానికి మిగిలిన ఎంచుకున్న ట్యాగ్‌లను పూర్తి చేయండి. తెలియని ఫీల్డ్‌ల వల్ల ఈ పాట “సమీక్ష అవసరం”లో ఉంటుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กรอกแท็กที่เลือกที่เหลือเพื่อบันทึกการซ่อมทั้งหมดพร้อมกัน ช่องที่ไม่ทราบจะทำให้เพลงนี้อยู่ใน “ต้องตรวจดู”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzeltmenin tamamını birlikte kaydetmek için seçili kalan etiketleri tamamlayın. Bilinmeyen alanlar bu şarkıyı İncelenecek’te tutar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заповніть решту вибраних тегів, щоб зберегти все виправлення разом. Через невідомі поля ця пісня лишається в розділі «Потребує перегляду»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پوری درستی ایک ساتھ محفوظ کرنے کے لیے باقی منتخب ٹیگز مکمل کریں۔ نامعلوم فیلڈز کی وجہ سے یہ گانا “جائزہ ضروری” میں رہتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoàn tất các thẻ đã chọn còn lại để lưu toàn bộ bản sửa cùng lúc. Trường chưa biết sẽ giữ bài này trong Cần xem lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填写剩余的选定标签，以便一次性保存整个修复。有未知字段时，这首歌会留在“需要查看”中。"
          }
        },
        "zh-Hant" : {
