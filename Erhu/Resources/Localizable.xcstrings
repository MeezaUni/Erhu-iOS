    "Lyrics sources are unavailable or rate-limited. No alternate results could be loaded." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مصادر الكلمات غير متاحة أو تحدّ من الطلبات. تعذّر تحميل نتيجة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কথার সোর্স উপলব্ধ নয় বা অনুরোধ সীমিত করছে। অন্য কোনো ফলাফল লোড করা যায়নি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Songtext-Quellen sind nicht verfügbar oder begrenzen Anfragen. Es konnten keine anderen Ergebnisse geladen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fuentes de letras no están disponibles o limitan las solicitudes. No se pudieron cargar otros resultados."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منابع متن ترانه در دسترس نیستند یا درخواست‌ها را محدود می‌کنند. نتیجهٔ دیگری بارگیری نشد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi available o nililimitahan ng mga pinagmulan ng lyrics ang mga kahilingan. Hindi ma-load ang ibang resulta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sources de paroles sont indisponibles ou limitent les requêtes. Aucun autre résultat n’a pu être chargé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बोल स्रोत उपलब्ध नहीं हैं या अनुरोध सीमित कर रहे हैं। कोई दूसरा परिणाम लोड नहीं हो सका।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sumber lirik tidak tersedia atau membatasi permintaan. Tidak ada hasil lain yang dapat dimuat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fonti dei testi non sono disponibili o limitano le richieste. Impossibile caricare altri risultati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌詞ソースが利用できないか、リクエストを制限しています。ほかの結果を読み込めませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가사 소스를 사용할 수 없거나 요청이 제한되었습니다. 다른 결과를 불러올 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Songtekstbronnen zijn niet beschikbaar of beperken verzoeken. Er konden geen andere resultaten worden geladen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
