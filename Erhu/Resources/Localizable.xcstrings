    "Choose a transition preset to enable cue trimming. Off plays the full outgoing track and the incoming track from its beginning." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر إعدادًا مسبقًا للانتقال لتفعيل قصّ نقاط الإشارة. يشغّل «إيقاف» المقطع المغادر كاملًا والمقطع القادم من بدايته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কিউ ছাঁটাই চালু করতে একটি ট্রানজিশন প্রিসেট বেছে নিন। বন্ধ থাকলে বিদায়ী ট্র্যাক পুরোটা এবং আগত ট্র্যাক শুরু থেকে বাজে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ein Übergangs-Preset, um Cue-Punkte zu kürzen. „Aus“ spielt den ausgehenden Titel vollständig und den eingehenden von Anfang an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un ajuste de transición para poder recortar los puntos. Desactivado reproduce la pista saliente completa y la entrante desde el principio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای فعال کردن برش نقطه‌ها یک پیش‌تنظیم گذار انتخاب کنید. «خاموش» آهنگ خروجی را کامل و آهنگ ورودی را از ابتدا پخش می‌کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pumili ng preset ng transition para i-on ang pag-trim ng cue. Pinapatugtog ng Off ang buong papalabas na track at ang papasok na track mula sa simula."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un préréglage de transition pour pouvoir rogner les repères. Désactivé joue le morceau sortant en entier et le morceau entrant depuis le début."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्यू ट्रिम करने के लिए कोई ट्रांज़िशन प्रीसेट चुनें। बंद होने पर जाता हुआ ट्रैक पूरा और आने वाला शुरू से बजता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih preset transisi untuk memangkas cue. Nonaktif memutar trek keluar sepenuhnya dan trek masuk dari awal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un preset di transizione per tagliare i cue. Disattivato riproduce il brano in uscita per intero e quello in entrata dall’inizio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キューのトリミングを有効にするにはトランジションのプリセットを選んでください。オフでは、前の曲を最後まで、次の曲を最初から再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "큐 트리밍을 사용하려면 트랜지션 프리셋을 선택하세요. 끄면 나가는 곡 전체와 들어오는 곡을 처음부터 재생합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een overgangsvoorinstelling om cuepunten bij te knippen. Uit speelt het uitgaande nummer volledig en het inkomende vanaf het begin."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz preset przejścia, aby włączyć przycinanie punktów. Wyłączone odtwarza cały utwór wychodzący, a przychodzący od początku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma predefinição de transição para poder cortar os pontos. Desativado toca a faixa de saída inteira e a de entrada desde o início."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите пресет перехода, чтобы обрезать метки. «Выкл.» проигрывает уходящий трек полностью, а входящий — с начала."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "க்யூ வெட்டலை இயக்க ஒரு மாற்ற முன்னமைவைத் தேர்ந்தெடுக்கவும். “முடக்கு” வெளியேறும் டிராக்கை முழுமையாகவும் உள்வரும் டிராக்கை தொடக்கத்திலிருந்தும் இயக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "క్యూ ట్రిమ్మింగ్‌ను ఆన్ చేయడానికి ట్రాన్సిషన్ ప్రీసెట్ ఎంచుకోండి. “ఆఫ్” వెళ్లే ట్రాక్‌ను పూర్తిగా, వచ్చే ట్రాక్‌ను మొదటి నుండి ప్లే చేస్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกพรีเซ็ตการเปลี่ยนผ่านเพื่อเปิดการตัดจุดคิว “ปิด” จะเล่นแทร็กที่ออกจนจบและเล่นแทร็กที่เข้าตั้งแต่ต้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşaretleri kırpmak için bir geçiş hazır ayarı seçin. Kapalı, çıkan parçayı tamamen, gelen parçayı baştan çalar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть пресет переходу, щоб увімкнути обрізання cue. «Вимк.» відтворює вихідний трек повністю, а вхідний — з початку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کیو تراشنا فعال کرنے کے لیے ٹرانزیشن پری سیٹ منتخب کریں۔ “بند” جانے والا ٹریک مکمل اور آنے والا ٹریک شروع سے چلاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn một cài sẵn chuyển tiếp để cắt điểm cue. Tắt sẽ phát trọn bài ra và bài vào từ đầu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一个过渡预设以启用提示点裁剪。关闭时会完整播放上一首，并从头播放下一首。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇一個過渡預設以啟用提示點裁剪。關閉時會完整播放上一首，並從頭播放下一首。"
          }
        }
      }
    },
