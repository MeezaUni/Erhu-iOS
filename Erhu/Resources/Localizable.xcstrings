        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " ; les échantillons au-delà de la pleine échelle sont écrêtés"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "; पूर्ण स्केल से ऊपर के सैंपल काटे जाते हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "; sampel di atas skala penuh dipotong"
