    "Keep listening and Erhu will build mixes from your plays." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واصل الاستماع وسيصنع Erhu مزيجات مما تشغّله."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুনতে থাকুন, Erhu আপনার শোনা গান থেকে মিক্স তৈরি করবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hör weiter, und Erhu erstellt Mixe aus deinen Wiedergaben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue escuchando y Erhu creará mezclas con lo que reproduces."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به گوش دادن ادامه دهید تا Erhu از پخش‌هایتان میکس بسازد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patuloy na makinig at gagawa ang Erhu ng mga mix mula sa mga pinapatugtog mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuez à écouter et Erhu créera des mix à partir de vos écoutes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुनते रहिए, Erhu आपके सुने हुए गानों से मिक्स बनाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terus dengarkan dan Erhu akan membuat mix dari putaran Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continua ad ascoltare ed Erhu creerà mix dai tuoi ascolti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聴き続けると、Erhu が再生履歴からミックスを作ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
