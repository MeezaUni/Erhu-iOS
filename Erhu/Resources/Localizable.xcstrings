        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bentuk gelombang sumber tidak tersedia. Pastikan kedua file audio dapat dibaca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una forma d’onda sorgente non è disponibile. Controlla che entrambi i file audio siano leggibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソース波形を利用できません。両方のオーディオファイルが読み込めるか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소스 파형을 사용할 수 없습니다. 두 오디오 파일을 모두 읽을 수 있는지 확인하세요."
