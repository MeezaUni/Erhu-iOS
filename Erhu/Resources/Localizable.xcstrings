    "Your current artwork changed after opening this comparison. Keep current, then search again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein aktuelles Cover hat sich nach dem Öffnen dieses Vergleichs geändert. Behalte das aktuelle und suche dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu portada actual cambió después de abrir esta comparación. Conserva la actual y busca de nuevo."
