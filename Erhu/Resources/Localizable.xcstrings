    "erhu is free. If you'd like to help get it onto the App Store, you can buy me a coffee." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erhu مجاني. إن أردت المساعدة في وصوله إلى App Store، يمكنك أن تشتري لي فنجان قهوة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erhu বিনামূল্যে। এটিকে App Store-এ আনতে সাহায্য করতে চাইলে আমাকে এক কাপ কফি কিনে দিতে পারেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erhu ist kostenlos. Wenn du helfen möchtest, es in den App Store zu bringen, kannst du mir einen Kaffee spendieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erhu es gratis. Si quieres ayudar a llevarlo a la App Store, puedes invitarme a un café."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erhu رایگان است. اگر می‌خواهید به رسیدنش به App Store کمک کنید، می‌توانید یک قهوه مهمانم کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libre ang erhu. Kung gusto mong tumulong na mailagay ito sa App Store, puwede mo akong ilibre ng kape."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erhu est gratuit. Si vous voulez aider à le mettre sur l’App Store, vous pouvez m’offrir un café."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erhu मुफ़्त है। अगर आप इसे App Store तक पहुँचाने में मदद करना चाहते हैं, तो मुझे एक कॉफ़ी पिला सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erhu gratis. Jika Anda ingin membantu membawanya ke App Store, Anda bisa mentraktir saya kopi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erhu è gratuito. Se vuoi aiutarlo ad arrivare sull’App Store, puoi offrirmi un caffè."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erhu は無料です。App Store への公開を応援していただけるなら、コーヒーを一杯ごちそうしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erhu는 무료입니다. App Store 출시를 돕고 싶다면 커피 한 잔 사 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erhu is gratis. Als je wilt helpen om het in de App Store te krijgen, kun je me op een kop koffie trakteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erhu jest darmowe. Jeśli chcesz pomóc trafić mu do App Store, możesz postawić mi kawę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O erhu é gratuito. Se quiser ajudar a colocá-lo na App Store, você pode me pagar um café."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erhu бесплатен. Если хотите помочь ему попасть в App Store, можете угостить меня кофе."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erhu இலவசம். இதை App Store க்குக் கொண்டுவர உதவ விரும்பினால், எனக்கு ஒரு காபி வாங்கித் தரலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erhu ఉచితం. దీన్ని App Store లోకి తీసుకురావడానికి సహాయం చేయాలనుకుంటే, నాకు ఒక కాఫీ కొనిపెట్టవచ్చు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erhu ใช้ฟรี หากคุณอยากช่วยให้ขึ้น App Store ได้ คุณเลี้ยงกาแฟฉันสักแก้วได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erhu ücretsizdir. App Store’a çıkmasına yardım etmek isterseniz bana bir kahve ısmarlayabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erhu безплатна. Якщо хочете допомогти їй потрапити в App Store, можете пригостити мене кавою."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erhu مفت ہے۔ اگر آپ اسے App Store پر لانے میں مدد کرنا چاہیں تو مجھے ایک کافی پلا سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erhu miễn phí. Nếu bạn muốn giúp nó lên App Store, bạn có thể mời tôi một ly cà phê."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erhu 是免费的。如果你想帮助它登上 App Store，可以请我喝杯咖啡。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erhu 是免費的。如果你想幫助它登上 App Store，可以請我喝杯咖啡。"
          }
        }
      }
    },
    "extended on-device estimate, %lld of %lld sections support it" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقدير موسّع على الجهاز، %1$lld من %2$lld أجزاء تؤيده"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বর্ধিত ডিভাইস অনুমান, %2$lldটি অংশের মধ্যে %1$lldটি সমর্থন করে"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erweiterte Schätzung auf dem Gerät, %lld von %lld Abschnitten stützen sie"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "estimación ampliada en el dispositivo, %lld de %lld secciones la respaldan"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برآورد گستردهٔ دستگاه، %1$lld از %2$lld بخش تأیید می‌کنند"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinalawak na tantiya sa device, %lld sa %lld na bahagi ang sumusuporta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "estimation étendue sur l’appareil, %lld sections sur %lld la confirment"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विस्तारित डिवाइस अनुमान, %2$lld में से %1$lld हिस्से इसका समर्थन करते हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "perkiraan diperluas di perangkat, %lld dari %lld bagian mendukungnya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "stima estesa sul dispositivo, %lld sezioni su %lld la confermano"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拡張したデバイス上の推定、%2$lld区間中%1$lld区間が支持"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확장 기기 추정, %2$lld개 구간 중 %1$lld개가 뒷받침"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "uitgebreide schatting op het apparaat, %lld van %lld delen ondersteunen die"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rozszerzony szacunek na urządzeniu, potwierdzających fragmentów: %lld z %lld"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "estimativa ampliada no dispositivo, %lld de %lld trechos a confirmam"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "расширенная оценка на устройстве, подтверждают %lld из %lld фрагментов"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "விரிவான சாதன மதிப்பீடு, %2$lld பகுதிகளில் %1$lld ஆதரிக்கின்றன"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "విస్తృత పరికర అంచనా, %2$lld భాగాలలో %1$lld మద్దతిస్తున్నాయి"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประมาณแบบขยายบนอุปกรณ์ %lld จาก %lld ช่วงสนับสนุน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "genişletilmiş cihazda tahmin, %lld / %lld bölüm destekliyor"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "розширена оцінка на пристрої, підтримують %lld з %lld фрагментів"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توسیعی ڈیوائس اندازہ، %2$lld میں سے %1$lld حصے حمایت کرتے ہیں"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ước tính mở rộng trên máy, %lld trong %lld đoạn ủng hộ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扩展设备端估算，%2$lld 个段落中 %1$lld 个支持"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "擴充套件裝置端估算，%2$lld 個段落中 %1$lld 個支援"
          }
        }
      }
    },
