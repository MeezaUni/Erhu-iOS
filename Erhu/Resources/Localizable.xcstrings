        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld枚中%1$lld枚の画像を改善しました。%3$lld枚は現在のアートワークのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지 %2$lld개 중 %1$lld개를 개선했습니다. %3$lld개는 현재 아트워크를 유지했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld van %lld afbeeldingen verbeterd. %lld behielden hun huidige hoes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulepszono %lld z %lld obrazów. %lld zachowało obecną okładkę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld de %lld imagens melhoradas. %lld mantiveram a capa atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Улучшено %lld из %lld изображений. У %lld осталась текущая обложка."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld படங்களில் %1$lld மேம்படுத்தப்பட்டன. %3$lld தங்கள் தற்போதைய அட்டையை வைத்திருந்தன."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld చిత్రాలలో %1$lld మెరుగుపరచబడ్డాయి. %3$lld తమ ప్రస్తుత కవర్‌ను ఉంచుకున్నాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อัปเกรด %lld จาก %lld ภาพแล้ว %lld ภาพยังใช้ภาพปกปัจจุบัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld / %lld görsel iyileştirildi. %lld tanesi mevcut kapağını korudu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покращено %lld з %lld зображень. %lld зберегли поточну обкладинку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld میں سے %1$lld تصاویر بہتر ہوئیں۔ %3$lld نے اپنا موجودہ کور رکھا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã cải tiến %lld / %lld ảnh. %lld ảnh giữ ảnh bìa hiện tại."
          }
        },
        "zh-Hans" : {
