    "Deezer found %lld matches but returned none: track search isn't available in this country" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وجد Deezer ‏%lld نتائج لكنه لم يُرجع أيًّا منها: البحث عن المقاطع غير متاح في هذا البلد"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deezer %lldটি মিল পেয়েছে কিন্তু কোনোটি দেয়নি: এই দেশে ট্র্যাক খোঁজা উপলব্ধ নয়"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deezer hat %lld Treffer gefunden, aber keinen geliefert: Die Titelsuche ist in diesem Land nicht verfügbar"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deezer encontró %lld coincidencias pero no devolvió ninguna: la búsqueda de pistas no está disponible en este país"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deezer %lld نتیجه یافت ولی هیچ‌کدام را برنگرداند: جست‌وجوی قطعه در این کشور در دسترس نیست"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakakita ang Deezer ng %lld resulta pero walang ibinalik: hindi available ang paghahanap ng track sa bansang ito"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deezer a trouvé %lld correspondances mais n’en a renvoyé aucune : la recherche de titres n’est pas disponible dans ce pays"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deezer को %lld मिलान मिले लेकिन कोई नहीं लौटाया: इस देश में ट्रैक खोज उपलब्ध नहीं है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deezer menemukan %lld kecocokan tetapi tidak mengembalikan satu pun: pencarian trek tidak tersedia di negara ini"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deezer ha trovato %lld corrispondenze ma non ne ha restituita nessuna: la ricerca di tracce non è disponibile in questo paese"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deezerで%lld件見つかりましたが、1件も返されませんでした：この国ではトラック検索を利用できません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deezer가 %lld개를 찾았지만 하나도 반환하지 않았습니다: 이 국가에서는 트랙 검색을 사용할 수 없습니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deezer vond %lld treffers maar gaf er geen terug: zoeken naar tracks is in dit land niet beschikbaar"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deezer znalazł %lld dopasowań, ale nie zwrócił żadnego: wyszukiwanie utworów nie jest dostępne w tym kraju"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Deezer encontrou %lld correspondências, mas não retornou nenhuma: a busca de faixas não está disponível neste país"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deezer нашёл совпадений: %lld, но не вернул ни одного: поиск треков недоступен в этой стране"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deezer %lld முடிவுகளைக் கண்டது, ஆனால் எதையும் அளிக்கவில்லை: இந்த நாட்டில் டிராக் தேடல் கிடைக்கவில்லை"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deezer %lld ఫలితాలను కనుగొంది కానీ ఏదీ ఇవ్వలేదు: ఈ దేశంలో ట్రాక్ శోధన అందుబాటులో లేదు"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deezer พบ %lld ผลแต่ไม่ได้ส่งกลับมาเลย: การค้นหาแทร็กไม่พร้อมใช้งานในประเทศนี้"
