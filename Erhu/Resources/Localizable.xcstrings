    "; samples beyond full scale are clipped" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "؛ تُقص العينات فوق المقياس الكامل"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "; ফুল স্কেলের ওপরের স্যাম্পল কাটা হয়"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "; Samples über der Vollaussteuerung werden beschnitten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "; las muestras por encima de la escala completa se recortan"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "؛ نمونه‌های بالای مقیاس کامل بریده می‌شوند"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "; kina-clip ang mga sample na lampas sa full scale"
