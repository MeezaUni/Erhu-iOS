          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دونوں ڈیوائسز پر VPN بند کریں، اور http:// سے شروع کرتے ہوئے پتہ بالکل درست لکھیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
