    "The transfer server didn't start (%@). Check that Wi-Fi is on, then try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يبدأ خادم النقل (%@). تحقق من تشغيل Wi-Fi، ثم حاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ট্রান্সফার সার্ভার চালু হয়নি (%@)। ওয়াই-ফাই চালু আছে কিনা দেখে আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Übertragungsserver wurde nicht gestartet (%@). Prüfe, ob das WLAN an ist, und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor de transferencia no se inició (%@). Comprueba que la Wi-Fi esté activada e inténtalo de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سرور انتقال شروع نشد (%@). بررسی کنید Wi-Fi روشن باشد، سپس دوباره امتحان کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi nagsimula ang transfer server (%@). Tiyaking naka-on ang Wi-Fi, saka subukang muli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur de transfert n’a pas démarré (%@). Vérifiez que le Wi-Fi est activé, puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रांसफ़र सर्वर शुरू नहीं हुआ (%@)। जाँचें कि Wi-Fi चालू है, फिर कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server transfer tidak berjalan (%@). Pastikan Wi-Fi aktif, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server di trasferimento non si è avviato (%@). Controlla che il Wi-Fi sia attivo, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "転送サーバが起動しませんでした（%@）。Wi-Fiがオンになっているか確認してからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전송 서버가 시작되지 않았습니다(%@). Wi-Fi가 켜져 있는지 확인하고 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De overdrachtsserver is niet gestart (%@). Controleer of wifi aan staat en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer przesyłania się nie uruchomił (%@). Sprawdź, czy Wi-Fi jest włączone, i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor de transferência não iniciou (%@). Verifique se o Wi-Fi está ligado e tente de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер передачи не запустился (%@). Проверьте, что Wi-Fi включён, и повторите попытку."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பரிமாற்றச் சேவையகம் தொடங்கவில்லை (%@). Wi-Fi இயக்கத்தில் உள்ளதா எனச் சரிபார்த்து மீண்டும் முயலவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "బదిలీ సర్వర్ ప్రారంభం కాలేదు (%@). Wi-Fi ఆన్‌లో ఉందో తనిఖీ చేసి మళ్ళీ ప్రయత్నించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เซิร์ฟเวอร์ถ่ายโอนไม่ได้เริ่มทำงาน (%@) ตรวจว่า Wi-Fi เปิดอยู่ แล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktarım sunucusu başlamadı (%@). Wi-Fi'ın açık olduğunu denetleyip yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер передачі не запустився (%@). Перевірте, що Wi-Fi увімкнено, і спробуйте знову."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ٹرانسفر سرور شروع نہیں ہوا (%@)۔ چیک کریں کہ وائی فائی آن ہے، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy chủ truyền không khởi động (%@). Hãy kiểm tra Wi-Fi đang bật rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "传输服务器未启动（%@）。请确认 Wi-Fi 已打开，然后重试。"
          }
        },
        "zh-Hant" : {
