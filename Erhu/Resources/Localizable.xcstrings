    "Upgraded %lld of %lld images. %lld kept their current artwork." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تحسين %1$lld من %2$lld صور. احتفظت %3$lld بغلافها الحالي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lldটি ছবির মধ্যে %1$lldটি উন্নত হয়েছে। %3$lldটি বর্তমান কভার রেখেছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld von %lld Bildern verbessert. %lld behielten ihr aktuelles Cover."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se mejoraron %lld de %lld imágenes. %lld conservaron su portada actual."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld از %2$lld تصویر بهبود یافت. %3$lld جلد فعلی خود را نگه داشتند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld sa %lld na larawan ang napahusay. %lld ang nagpanatili ng kasalukuyang cover."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld images améliorées sur %lld. %lld ont conservé leur pochette actuelle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld में से %1$lld छवियाँ बेहतर हुईं। %3$lld ने अपना मौजूदा कवर रखा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld dari %lld gambar ditingkatkan. %lld mempertahankan sampul saat ini."
          }
