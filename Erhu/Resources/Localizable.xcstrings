    "Describe a mood, a sound, or what you're doing. Find the right music in your library, offline." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صِف مزاجًا أو صوتًا أو ما تفعله. اعثر على الموسيقى المناسبة في مكتبتك دون اتصال."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি মুড, একটি শব্দ বা আপনি কী করছেন তা বর্ণনা করুন। আপনার লাইব্রেরিতে অফলাইনে সঠিক গান খুঁজুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschreibe eine Stimmung, einen Sound oder was du gerade tust. Finde die passende Musik in deiner Mediathek, offline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe un estado de ánimo, un sonido o lo que estás haciendo. Encuentra la música adecuada en tu biblioteca, sin conexión."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک حال‌وهوا، یک صدا یا کاری که انجام می‌دهید را توصیف کنید. موسیقی مناسب را به‌صورت آفلاین در کتابخانه‌تان پیدا کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilarawan ang isang mood, tunog, o ang ginagawa mo. Hanapin ang tamang musika sa library mo, offline."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décrivez une ambiance, un son ou ce que vous faites. Trouvez la bonne musique dans votre bibliothèque, hors ligne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई मूड, कोई आवाज़, या आप क्या कर रहे हैं, बताइए। अपनी लाइब्रेरी में सही संगीत ढूँढें, ऑफ़लाइन।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelaskan suasana, suara, atau apa yang sedang Anda lakukan. Temukan musik yang pas di pustaka Anda, offline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descrivi un umore, un suono o cosa stai facendo. Trova la musica giusta nella tua libreria, offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ムード、サウンド、または今していることを入力してください。ライブラリからぴったりの音楽をオフラインで見つけます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분위기, 사운드 또는 지금 하는 일을 설명하세요. 보관함에서 알맞은 음악을 오프라인으로 찾아 드립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschrijf een stemming, een geluid of wat je aan het doen bent. Vind de juiste muziek in je bibliotheek, offline."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opisz nastrój, brzmienie lub to, co robisz. Znajdź odpowiednią muzykę w bibliotece, offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descreva um clima, um som ou o que você está fazendo. Encontre a música certa na sua biblioteca, offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опишите настроение, звучание или чем вы заняты. Найдите подходящую музыку в своей медиатеке — офлайн."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒரு மனநிலை, ஒலி அல்லது நீங்கள் செய்வதை விவரிக்கவும். உங்கள் நூலகத்தில் சரியான இசையை ஆஃப்லைனில் கண்டறியவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఒక మూడ్, ఒక ధ్వని లేదా మీరు చేస్తున్న పనిని వివరించండి. మీ లైబ్రరీలో సరైన సంగీతాన్ని ఆఫ్‌లైన్‌లో కనుగొనండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อธิบายอารมณ์ เสียง หรือสิ่งที่คุณกำลังทำ แล้วค้นหาเพลงที่ใช่ในคลังของคุณแบบออฟไลน์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ruh hali, bir ses veya ne yaptığınızı anlatın. Arşivinizdeki doğru müziği çevrimdışı bulun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опишіть настрій, звучання або те, чим ви зайняті. Знайдіть потрібну музику у своїй медіатеці офлайн."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کسی موڈ، آواز یا اپنی سرگرمی کو بیان کریں۔ اپنی لائبریری میں آف لائن صحیح موسیقی تلاش کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mô tả một tâm trạng, một âm thanh hoặc việc bạn đang làm. Tìm đúng nhạc trong thư viện, ngoại tuyến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描述一种心情、一种声音或你正在做的事。离线在资料库中找到合适的音乐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描述一種心情、一種聲音或你正在做的事。離線在資料庫中找到合適的音樂。"
          }
        }
      }
    },
