    "Found online values are held for you. All selected tags must be complete before anything is saved. Blank fields stay unresolved." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartości znalezione online są dla ciebie zachowane. Wszystkie wybrane tagi muszą być kompletne, zanim cokolwiek zostanie zapisane. Puste pola pozostają nierozwiązane."
          }
        }
      }
    },
    "Fresh in Your Library" : {
