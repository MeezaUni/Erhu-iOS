    "Check paused: %@ Continue later to check the remaining albums." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف الفحص: %@ تابع لاحقًا لفحص الألبومات المتبقية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যাচাই বিরতিতে: %@ বাকি অ্যালবাম যাচাই করতে পরে চালিয়ে যান।"
          }
        },
        "de" : {
