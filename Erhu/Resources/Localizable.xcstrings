    },
    "Albums whose songs carry no cover. A cover you pick is saved into every song of the album." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ألبومات لا تحمل أغانيها غلافًا. يُحفظ الغلاف الذي تختاره في كل أغنية من الألبوم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যেসব অ্যালবামের গানে কভার নেই। আপনার বেছে নেওয়া কভার অ্যালবামের প্রতিটি গানে সংরক্ষিত হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alben, deren Titel kein Cover haben. Das gewählte Cover wird in jedem Titel des Albums gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Álbumes cuyas canciones no tienen portada. La portada que elijas se guarda en todas las canciones del álbum."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آلبوم‌هایی که آهنگ‌هایشان جلد ندارند. جلدی که انتخاب کنید در همه آهنگ‌های آلبوم ذخیره می‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mga album na walang cover ang mga kanta. Ang cover na pipiliin mo ay mase-save sa bawat kanta ng album."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albums dont les morceaux n’ont pas de pochette. La pochette choisie est enregistrée dans chaque morceau de l’album."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐसे एल्बम जिनके गानों में कवर नहीं है। आप जो कवर चुनेंगे, वह एल्बम के हर गाने में सहेजा जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Album yang lagunya tidak punya sampul. Sampul yang Anda pilih disimpan ke setiap lagu di album itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Album i cui brani non hanno copertina. La copertina scelta viene salvata in ogni brano dell’album."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲にカバーが入っていないアルバムです。選んだカバーはアルバムのすべての曲に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노래에 커버가 없는 앨범입니다. 선택한 커버는 앨범의 모든 노래에 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albums waarvan de nummers geen hoes hebben. De gekozen hoes wordt in elk nummer van het album bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albumy, których utwory nie mają okładki. Wybrana okładka zostanie zapisana w każdym utworze albumu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Álbuns cujas músicas não têm capa. A capa escolhida é salva em todas as músicas do álbum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Альбомы, у треков которых нет обложки. Выбранная обложка сохраняется в каждый трек альбома."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பாடல்களில் அட்டை இல்லாத ஆல்பங்கள். நீங்கள் தேர்ந்தெடுக்கும் அட்டை ஆல்பத்தின் ஒவ்வொரு பாடலிலும் சேமிக்கப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పాటల్లో కవర్ లేని ఆల్బమ్‌లు. మీరు ఎంచుకున్న కవర్ ఆల్బమ్‌లోని ప్రతి పాటలో సేవ్ అవుతుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อัลบั้มที่เพลงไม่มีปก ปกที่คุณเลือกจะถูกบันทึกลงในทุกเพลงของอัลบั้ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şarkılarında kapak olmayan albümler. Seçtiğiniz kapak albümün her şarkısına kaydedilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Альбоми, пісні яких не мають обкладинки. Вибрана обкладинка зберігається в кожну пісню альбому."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ البمز جن کے گانوں میں کور نہیں۔ آپ کا چنا ہوا کور البم کے ہر گانے میں محفوظ ہوتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các album có bài hát không có ảnh bìa. Ảnh bìa bạn chọn được lưu vào mọi bài của album."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些专辑的歌曲没有封面。你选的封面会保存到专辑的每首歌曲中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些專輯的歌曲沒有封面。你選的封面會儲存到專輯的每首歌曲中。"
          }
        }
      }
    },
    "Albums with a downloaded animated cover: %lld. Skipped albums stay in the list to review on their own." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الألبومات ذات الغلاف المتحرك المنزَّل: %lld. تبقى الألبومات المتخطّاة في القائمة لمراجعتها على حدة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডাউনলোড করা অ্যানিমেটেড কভারসহ অ্যালবাম: %lld। এড়িয়ে যাওয়া অ্যালবাম আলাদাভাবে দেখার জন্য তালিকায় থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alben mit heruntergeladenem animiertem Cover: %lld. Übersprungene Alben bleiben in der Liste, um sie einzeln zu prüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Álbumes con portada animada descargada: %lld. Los álbumes omitidos siguen en la lista para revisarlos por separado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آلبوم‌های دارای جلد متحرک بارگیری‌شده: %lld. آلبوم‌های ردشده برای بررسی جداگانه در فهرست می‌مانند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mga album na may na-download na animated cover: %lld. Mananatili sa listahan ang mga nilaktawang album para masuri nang hiwalay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albums avec une pochette animée téléchargée : %lld. Les albums ignorés restent dans la liste pour être vérifiés à part."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डाउनलोड किए गए एनिमेटेड कवर वाले एल्बम: %lld. छोड़े गए एल्बम अलग से देखने के लिए सूची में रहते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Album dengan sampul animasi yang sudah diunduh: %lld. Album yang dilewati tetap di daftar untuk ditinjau sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Album con copertina animata scaricata: %lld. Gli album saltati restano nell’elenco per essere controllati a parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アニメーションカバーをダウンロード済みのアルバム：%lld。スキップしたアルバムは個別に確認できるよう一覧に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "애니메이션 커버를 다운로드한 앨범: %lld. 건너뛴 앨범은 따로 검토할 수 있도록 목록에 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albums met een gedownloade bewegende hoes: %lld. Overgeslagen albums blijven in de lijst om apart te bekijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albumy z pobraną animowaną okładką: %lld. Pominięte albumy zostają na liście do osobnego przejrzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Álbuns com capa animada baixada: %lld. Os álbuns pulados ficam na lista para revisar separadamente."
