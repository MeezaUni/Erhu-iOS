        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此添加歌曲，或在任意歌曲的菜单中选择“在线修复标签”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此新增歌曲，或在任意歌曲的選單中選擇「線上修復標籤」。"
          }
        }
      }
    },
