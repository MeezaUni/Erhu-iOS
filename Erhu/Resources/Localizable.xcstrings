    "The app is not adding gain, so its processing adds no clipping risk." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يضيف التطبيق كسبًا، لذا لا ترفع معالجته خطر القص."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপ গেইন যোগ করে না, তাই এর প্রক্রিয়াকরণে ক্লিপিংয়ের ঝুঁকি বাড়ে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App fügt keine Verstärkung hinzu, daher bringt ihre Verarbeitung kein Übersteuerungsrisiko."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app no añade ganancia, así que su procesamiento no añade riesgo de saturación."
          }
        },
        "fa" : {
          "stringUnit" : {
