    "The animated-cover check finished." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Prüfung auf bewegte Cover ist abgeschlossen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La comprobación de portadas animadas terminó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vérification des pochettes animées est terminée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एनिमेटेड कवर की जाँच पूरी हुई।"
