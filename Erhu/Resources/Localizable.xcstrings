          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் நூலகத்தின் வகைகள், டெம்போ, கலைஞர்கள் மற்றும் சேமித்த வரிகளுடன் பொருத்தப்பட்டது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ లైబ్రరీలోని శైలులు, టెంపో, కళాకారులు మరియు సేవ్ చేసిన సాహిత్యంతో సరిపోల్చబడింది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จับคู่จากแนวเพลง จังหวะ ศิลปิน และเนื้อเพลงที่บันทึกในคลังของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arşivinizin türleri, tempoları, sanatçıları ve kaydedilen şarkı sözleriyle eşleştirildi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підібрано за жанрами, темпом, виконавцями й збереженими текстами вашої медіатеки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کی لائبریری کی اصناف، ٹیمپو، فنکاروں اور محفوظ بولوں سے ملایا گیا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghép theo thể loại, nhịp độ, nghệ sĩ và lời đã lưu trong thư viện của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
