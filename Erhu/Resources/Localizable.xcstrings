            "value" : "ట్రాక్‌లను కలపడానికి “ఫేడ్” లేదా మరో ప్రీసెట్ ఎంచుకోండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือก “เฟด” หรือพรีเซ็ตอื่นเพื่อผสมแทร็ก"
          }
        },
        "tr" : {
