    "Music is saved to Erhu's folder (Files › On My iPhone › Erhu) and appears in your library shortly after." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik wird im Erhu-Ordner gespeichert (Dateien › Auf meinem iPhone › Erhu) und erscheint kurz darauf in deiner Mediathek."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La música se guarda en la carpeta de Erhu (Archivos › En mi iPhone › Erhu) y aparece en tu biblioteca poco después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La musique est enregistrée dans le dossier d’Erhu (Fichiers › Sur mon iPhone › Erhu) et apparaît peu après dans votre bibliothèque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संगीत Erhu के फ़ोल्डर (फ़ाइलें › मेरे iPhone पर › Erhu) में सहेजा जाता है और जल्द ही आपकी लाइब्रेरी में दिखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik disimpan ke folder Erhu (File › Di iPhone Saya › Erhu) dan muncul di pustaka Anda tak lama kemudian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La musica viene salvata nella cartella di Erhu (File › Sul mio iPhone › Erhu) e compare poco dopo nella libreria."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muziek wordt bewaard in de map van Erhu (Bestanden › Op mijn iPhone › Erhu) en verschijnt kort daarna in je bibliotheek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muzyka jest zapisywana w folderze Erhu (Pliki › Na moim iPhonie › Erhu) i wkrótce pojawia się w bibliotece."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As músicas são salvas na pasta do Erhu (Arquivos › No Meu iPhone › Erhu) e aparecem na sua biblioteca logo depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Музыка сохраняется в папку Erhu («Файлы» › «На iPhone» › Erhu) и вскоре появляется в медиатеке."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Müzik Erhu klasörüne (Dosyalar › iPhone'umda › Erhu) kaydedilir ve kısa süre sonra arşivinizde görünür."
          }
        }
      }
    },
