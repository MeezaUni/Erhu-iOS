          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поточна обкладинка змінилася після відкриття цього порівняння. Залиште поточну, а потім повторіть пошук."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ موازنہ کھولنے کے بعد آپ کا موجودہ کور بدل گیا۔ موجودہ رکھیں، پھر دوبارہ تلاش کریں۔"
