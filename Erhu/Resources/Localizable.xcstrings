            "state" : "translated",
            "value" : "Wybierz Wyciszenie lub inny preset, aby łączyć utwory."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha Fade ou outra predefinição para misturar as faixas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите «Затухание» или другой пресет, чтобы сводить треки."
