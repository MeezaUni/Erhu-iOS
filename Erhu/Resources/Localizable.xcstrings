    "Saved progress restored. Continue with the remaining tracks; completed tracks are skipped." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت استعادة التقدم المحفوظ. تابع مع المقاطع المتبقية؛ سيتم تخطي المقاطع المكتملة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংরক্ষিত অগ্রগতি ফেরানো হয়েছে। বাকি ট্র্যাক দিয়ে চালিয়ে যান; সম্পন্নগুলো বাদ যাবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeicherter Fortschritt wiederhergestellt. Fahre mit den verbleibenden Titeln fort; abgeschlossene werden übersprungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progreso guardado restaurado. Continúa con las pistas restantes; las completadas se omiten."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیشرفت ذخیره‌شده بازیابی شد. با قطعه‌های باقی‌مانده ادامه دهید؛ قطعه‌های تمام‌شده رد می‌شوند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
