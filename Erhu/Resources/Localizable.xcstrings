          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте пісні сюди або виберіть «Виправити теги онлайн» у меню будь-якої пісні."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہاں گانے شامل کریں، یا کسی بھی گانے کے مینو میں “ٹیگز آن لائن درست کریں” منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm bài hát vào đây, hoặc chọn “Sửa thẻ trực tuyến” trong menu của bài bất kỳ."
          }
