    "Compression did not make this cover smaller. Your original is unchanged." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Komprimierung hat dieses Cover nicht verkleinert. Dein Original bleibt unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La compresión no redujo el tamaño de esta portada. El original no cambia."
          }
        },
        "fr" : {
