    "A source waveform is unavailable. Check that both audio files are readable." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الموجة الصوتية للمصدر غير متاحة. تحقّق من أن ملفي الصوت قابلان للقراءة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সোর্স ওয়েভফর্ম পাওয়া যাচ্ছে না। দুটি অডিও ফাইলই পড়া যায় কিনা দেখুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Quell-Wellenform fehlt. Prüfe, ob beide Audiodateien lesbar sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay forma de onda de origen. Comprueba que ambos archivos de audio se puedan leer."
