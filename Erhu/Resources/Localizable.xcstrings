        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এগুলো আলগা মিল। একটি ঘরানা চেষ্টা করুন বা আরেকটু বিবরণ দিন।"
          }
        },
        "de" : {
