        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों डिवाइसों पर VPN बंद करें, और पता ठीक-ठीक लिखें, http:// से शुरू करके।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
