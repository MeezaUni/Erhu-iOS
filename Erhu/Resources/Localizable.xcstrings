    "Albums checked: %lld. Motion covers available: %lld." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الألبومات المفحوصة: %lld. الأغلفة المتحركة المتاحة: %lld."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যাচাই করা অ্যালবাম: %lld। উপলব্ধ অ্যানিমেটেড কভার: %lld।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geprüfte Alben: %lld. Verfügbare bewegte Cover: %lld."
