    "Sends only the title, artist, album and length. Tap a match to copy its values into the fields above, then check them before saving." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسل العنوان والفنان والألبوم والمدة فقط. اضغط على مطابقة لنسخ قيمها إلى الحقول أعلاه، ثم تحقّق منها قبل الحفظ."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধু শিরোনাম, শিল্পী, অ্যালবাম ও দৈর্ঘ্য পাঠায়। মান উপরের ফিল্ডে কপি করতে একটি মিলে ট্যাপ করুন, তারপর সংরক্ষণের আগে যাচাই করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet nur Titel, Interpret, Album und Länge. Tippe auf einen Treffer, um seine Werte in die Felder oben zu übernehmen, und prüfe sie vor dem Sichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo envía el título, el artista, el álbum y la duración. Toca una coincidencia para copiar sus valores en los campos de arriba y revísalos antes de guardar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط عنوان، هنرمند، آلبوم و مدت را می‌فرستد. روی یک نتیجه ضربه بزنید تا مقادیرش در فیلدهای بالا کپی شود، سپس پیش از ذخیره بررسی‌شان کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamagat, artist, album at haba lang ang ipinapadala. I-tap ang isang tugma para kopyahin ang mga value nito sa mga field sa itaas, saka suriin bago i-save."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’envoie que le titre, l’artiste, l’album et la durée. Touchez une correspondance pour copier ses valeurs dans les champs ci-dessus, puis vérifiez-les avant d’enregistrer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ शीर्षक, कलाकार, एल्बम और अवधि भेजता है। किसी मिलान को टैप करके उसके मान ऊपर के फ़ील्ड में कॉपी करें, फिर सहेजने से पहले जाँच लें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya mengirim judul, artis, album, dan durasi. Ketuk kecocokan untuk menyalin nilainya ke kolom di atas, lalu periksa sebelum menyimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia solo titolo, artista, album e durata. Tocca una corrispondenza per copiarne i valori nei campi sopra, poi controllali prima di salvare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信するのはタイトル、アーティスト、アルバム、長さだけです。一致結果をタップすると上の項目に値がコピーされます。保存前に確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제목, 아티스트, 앨범, 길이만 보냅니다. 일치 결과를 탭하면 위 항목에 값이 복사되며, 저장 전에 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuurt alleen titel, artiest, album en duur. Tik op een match om de waarden naar de velden hierboven te kopiëren, en controleer ze voor het bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyła tylko tytuł, wykonawcę, album i długość. Stuknij dopasowanie, aby skopiować jego wartości do pól powyżej, a potem sprawdź je przed zapisem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envia só o título, artista, álbum e duração. Toque numa correspondência para copiar os valores para os campos acima e confira antes de salvar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляются только название, исполнитель, альбом и длительность. Коснитесь совпадения, чтобы скопировать значения в поля выше, и проверьте их перед сохранением."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தலைப்பு, கலைஞர், ஆல்பம் மற்றும் நீளத்தை மட்டும் அனுப்பும். மதிப்புகளை மேலே உள்ள புலங்களில் நகலெடுக்க ஒரு பொருத்தத்தைத் தட்டி, சேமிக்கும் முன் சரிபார்க்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "శీర్షిక, కళాకారుడు, ఆల్బమ్, నిడివి మాత్రమే పంపుతుంది. విలువలను పై ఫీల్డ్‌లలోకి కాపీ చేయడానికి సరిపోలికను ట్యాప్ చేసి, సేవ్ చేసే ముందు తనిఖీ చేయండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งเฉพาะชื่อเพลง ศิลปิน อัลบั้ม และความยาว แตะผลที่ตรงกันเพื่อคัดลอกค่าลงช่องด้านบน แล้วตรวจก่อนบันทึก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca başlık, sanatçı, albüm ve süreyi gönderir. Değerlerini yukarıdaki alanlara kopyalamak için bir eşleşmeye dokunun ve kaydetmeden önce kontrol edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надсилає лише назву, виконавця, альбом і тривалість. Торкніться збігу, щоб скопіювати значення в поля вище, і перевірте їх перед збереженням."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صرف عنوان، فنکار، البم اور دورانیہ بھیجتا ہے۔ قدریں اوپر کی فیلڈز میں کاپی کرنے کے لیے کسی نتیجے پر ٹیپ کریں، پھر محفوظ کرنے سے پہلے انہیں چیک کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ gửi tiêu đề, nghệ sĩ, album và thời lượng. Chạm vào một kết quả để chép giá trị vào các trường ở trên, rồi kiểm tra trước khi lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只发送标题、艺人、专辑和时长。轻点一个匹配结果可将其值复制到上方字段，保存前请检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只傳送標題、藝人、專輯和時長。輕點一個匹配結果可將其值複製到上方欄位，儲存前請檢查。"
          }
        }
      }
    },
