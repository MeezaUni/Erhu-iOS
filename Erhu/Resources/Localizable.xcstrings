    "Fully fixed %@; %lld still need review. Incomplete repairs were not written." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مصحّح بالكامل: %@؛ %lld لا تزال بحاجة إلى مراجعة. لم تُكتب التصحيحات الجزئية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পুরোপুরি ঠিক: %@; %lldটির এখনো পর্যালোচনা দরকার। অসম্পূর্ণ সংশোধন লেখা হয়নি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vollständig repariert: %@; %lld müssen noch geprüft werden. Unvollständige Reparaturen wurden nicht geschrieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reparadas por completo %@; %lld aún necesitan revisión. Las reparaciones incompletas no se escribieron."
