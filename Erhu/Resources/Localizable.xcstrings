    "Keep Erhu open while sending: iOS pauses the transfer when the app is in the background." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ Erhu مفتوحًا أثناء الإرسال: يوقف iOS النقل مؤقتًا عندما يكون التطبيق في الخلفية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পাঠানোর সময় Erhu খোলা রাখুন: অ্যাপ ব্যাকগ্রাউন্ডে থাকলে iOS ট্রান্সফার থামিয়ে দেয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass Erhu beim Senden geöffnet: iOS pausiert die Übertragung, wenn die App im Hintergrund ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén Erhu abierto mientras envías: iOS pausa la transferencia cuando la app está en segundo plano."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنگام فرستادن Erhu را باز نگه دارید: اگر برنامه در پس‌زمینه باشد، iOS انتقال را مکث می‌کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panatilihing bukas ang Erhu habang nagpapadala: pino-pause ng iOS ang transfer kapag nasa background ang app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez Erhu ouvert pendant l’envoi : iOS met le transfert en pause quand l’app est en arrière-plan."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भेजते समय Erhu खुला रखें: ऐप बैकग्राउंड में होने पर iOS ट्रांसफ़र रोक देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biarkan Erhu terbuka saat mengirim: iOS menjeda transfer saat aplikasi berada di latar belakang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni Erhu aperta durante l’invio: iOS mette in pausa il trasferimento quando l’app è in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信中はErhuを開いたままにしてください。アプリがバックグラウンドになるとiOSが転送を一時停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보내는 동안 Erhu를 열어 두세요. 앱이 백그라운드에 있으면 iOS가 전송을 일시 정지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd Erhu open tijdens het versturen: iOS pauzeert de overdracht als de app op de achtergrond staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie zamykaj Erhu podczas wysyłania: iOS wstrzymuje przesyłanie, gdy aplikacja działa w tle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o Erhu aberto durante o envio: o iOS pausa a transferência quando o app está em segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не закрывайте Erhu во время отправки: iOS приостанавливает передачу, когда приложение в фоне."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அனுப்பும்போது Erhu ஐத் திறந்து வைக்கவும்: பயன்பாடு பின்னணியில் இருந்தால் iOS பரிமாற்றத்தை இடைநிறுத்துகிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పంపేటప్పుడు Erhu ను తెరిచి ఉంచండి: యాప్ నేపథ్యంలో ఉంటే iOS బదిలీని పాజ్ చేస్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิด Erhu ไว้ขณะส่ง: iOS จะหยุดการถ่ายโอนชั่วคราวเมื่อแอปอยู่เบื้องหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gönderirken Erhu'yu açık tutun: uygulama arka plandayken iOS aktarımı duraklatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не закривайте Erhu під час надсилання: iOS призупиняє передачу, коли програма у фоні."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بھیجتے وقت Erhu کھلا رکھیں: ایپ پس منظر میں ہو تو iOS ٹرانسفر روک دیتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ Erhu mở khi gửi: iOS tạm dừng việc truyền khi ứng dụng chạy nền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送时请保持 Erhu 打开：应用在后台时 iOS 会暂停传输。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "傳送時請保持 Erhu 開啟：應用在後臺時 iOS 會暫停傳輸。"
          }
        }
      }
    },
    "Keep both devices on this Wi-Fi until it finishes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ الجهازين على شبكة Wi-Fi هذه حتى الانتهاء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
