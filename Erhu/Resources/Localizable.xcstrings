          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірено альбомів: %lld. Доступно анімованих обкладинок: %lld."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چیک کیے گئے البمز: %lld۔ دستیاب متحرک کورز: %lld۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Album đã kiểm tra: %lld. Ảnh bìa động có sẵn: %lld."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
