    "Choose a match for each remaining reference." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر تطابقًا لكل مرجع متبقٍّ."
          }
        },
        "bn" : {
