        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik wird im Erhu-Ordner gespeichert (Dateien › Auf meinem iPhone › Erhu) und erscheint kurz darauf in deiner Mediathek."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La música se guarda en la carpeta de Erhu (Archivos › En mi iPhone › Erhu) y aparece en tu biblioteca poco después."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موسیقی در پوشهٔ Erhu (Files › در iPhone من › Erhu) ذخیره می‌شود و به‌زودی در کتابخانه‌تان ظاهر می‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sine-save ang musika sa folder ng Erhu (Files › Sa iPhone Ko › Erhu) at lalabas agad sa library mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La musique est enregistrée dans le dossier d’Erhu (Fichiers › Sur mon iPhone › Erhu) et apparaît peu après dans votre bibliothèque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संगीत Erhu के फ़ोल्डर (फ़ाइलें › मेरे iPhone पर › Erhu) में सहेजा जाता है और जल्द ही आपकी लाइब्रेरी में दिखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik disimpan ke folder Erhu (File › Di iPhone Saya › Erhu) dan muncul di pustaka Anda tak lama kemudian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La musica viene salvata nella cartella di Erhu (File › Sul mio iPhone › Erhu) e compare poco dopo nella libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音楽はErhuのフォルダ（ファイル › このiPhone内 › Erhu）に保存され、まもなくライブラリに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음악은 Erhu 폴더(파일 › 나의 iPhone › Erhu)에 저장되고 곧 보관함에 나타납니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muziek wordt bewaard in de map van Erhu (Bestanden › Op mijn iPhone › Erhu) en verschijnt kort daarna in je bibliotheek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muzyka jest zapisywana w folderze Erhu (Pliki › Na moim iPhonie › Erhu) i wkrótce pojawia się w bibliotece."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As músicas são salvas na pasta do Erhu (Arquivos › No Meu iPhone › Erhu) e aparecem na sua biblioteca logo depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Музыка сохраняется в папку Erhu («Файлы» › «На iPhone» › Erhu) и вскоре появляется в медиатеке."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இசை Erhu கோப்புறையில் (கோப்புகள் › என் iPhone இல் › Erhu) சேமிக்கப்பட்டு விரைவில் உங்கள் நூலகத்தில் தோன்றும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సంగీతం Erhu ఫోల్డర్‌లో (ఫైల్‌లు › నా iPhone లో › Erhu) సేవ్ అవుతుంది మరియు త్వరలో మీ లైబ్రరీలో కనిపిస్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพลงจะถูกบันทึกในโฟลเดอร์ของ Erhu (ไฟล์ › บน iPhone ของฉัน › Erhu) และปรากฏในคลังของคุณไม่นานหลังจากนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Müzik Erhu klasörüne (Dosyalar › iPhone'umda › Erhu) kaydedilir ve kısa süre sonra arşivinizde görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Музика зберігається в теці Erhu («Файли» › «На моєму iPhone» › Erhu) і невдовзі з’являється в медіатеці."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موسیقی Erhu کے فولڈر (فائلز › میرے iPhone پر › Erhu) میں محفوظ ہوتی ہے اور جلد ہی آپ کی لائبریری میں نظر آتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhạc được lưu vào thư mục của Erhu (Tệp › Trên iPhone › Erhu) và xuất hiện trong thư viện ngay sau đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音乐会保存到 Erhu 的文件夹（文件 › 我的 iPhone › Erhu），并很快出现在你的资料库中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音樂會儲存到 Erhu 的資料夾（檔案 › 我的 iPhone › Erhu），並很快出現在你的資料庫中。"
          }
        }
      }
    },
