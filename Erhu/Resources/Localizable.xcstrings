    "Ready for the Lock Screen. Tap the cover there to expand it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جاهز لشاشة القفل. اضغط الغلاف هناك لتوسيعه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লক স্ক্রিনের জন্য প্রস্তুত। বড় করতে সেখানে কভারে ট্যাপ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereit für den Sperrbildschirm. Tippe dort auf das Cover, um es zu vergrößern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista para la pantalla de bloqueo. Toca allí la portada para ampliarla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای صفحه قفل آماده است. برای گسترش، آنجا روی جلد ضربه بزنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handa na para sa Lock Screen. I-tap doon ang cover para palakihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prête pour l’écran verrouillé. Touchez-y la pochette pour l’agrandir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लॉक स्क्रीन के लिए तैयार। बड़ा करने के लिए वहाँ कवर पर टैप करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siap untuk Layar Terkunci. Ketuk sampul di sana untuk memperbesarnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pronta per la schermata di blocco. Tocca lì la copertina per ingrandirla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロック画面の準備ができました。そこでカバーをタップすると拡大します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금 화면 준비 완료. 그곳에서 커버를 탭하면 펼쳐집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klaar voor het toegangsscherm. Tik daar op de hoes om hem te vergroten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gotowe na ekran blokady. Stuknij tam okładkę, aby ją powiększyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pronta para a tela de bloqueio. Toque na capa lá para ampliá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Готово для экрана блокировки. Коснитесь там обложки, чтобы развернуть её."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பூட்டுத் திரைக்குத் தயார். விரிவாக்க அங்கே அட்டையைத் தட்டவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "లాక్ స్క్రీన్‌కు సిద్ధం. విస్తరించడానికి అక్కడ కవర్‌ను ట్యాప్ చేయండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พร้อมสำหรับหน้าจอล็อกแล้ว แตะปกที่นั่นเพื่อขยาย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilit ekranı için hazır. Genişletmek için oradaki kapağa dokunun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Готово для екрана блокування. Торкніться там обкладинки, щоб розгорнути її."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لاک اسکرین کے لیے تیار۔ پھیلانے کے لیے وہاں کور پر ٹیپ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sẵn sàng cho Màn hình khóa. Chạm vào ảnh bìa ở đó để mở rộng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已为锁定屏幕准备好。在那里轻点封面即可展开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已為鎖定畫面準備好。在那裡輕點封面即可展開。"
          }
        }
      }
    },
