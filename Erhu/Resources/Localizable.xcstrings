        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آلبوم‌های بررسی‌شده: %lld. جلدهای متحرک موجود: %lld."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mga nasuring album: %lld. Mga available na gumagalaw na cover: %lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albums vérifiés : %lld. Pochettes animées disponibles : %lld."
