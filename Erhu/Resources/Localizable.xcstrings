    "Metadata and artwork searches use keyless iTunes Search, MusicBrainz, Deezer, Wikidata and Wikimedia Commons. No API keys are needed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم البحث عن البيانات الوصفية والصور خدمات iTunes Search وMusicBrainz وDeezer وWikidata وWikimedia Commons دون مفاتيح. لا حاجة إلى مفاتيح API."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মেটাডেটা ও আর্টওয়ার্ক খোঁজে কী-বিহীন iTunes Search, MusicBrainz, Deezer, Wikidata ও Wikimedia Commons ব্যবহার হয়। কোনো API কী লাগে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metadaten- und Coversuche nutzen iTunes Search, MusicBrainz, Deezer, Wikidata und Wikimedia Commons ohne Schlüssel. API-Schlüssel sind nicht nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las búsquedas de metadatos y portadas usan iTunes Search, MusicBrainz, Deezer, Wikidata y Wikimedia Commons sin claves. No se necesitan claves de API."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جست‌وجوی فراداده و تصویر از iTunes Search، MusicBrainz، Deezer، Wikidata و Wikimedia Commons بدون کلید استفاده می‌کند. هیچ کلید API لازم نیست."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumagamit ang paghahanap ng metadata at artwork ng walang-key na iTunes Search, MusicBrainz, Deezer, Wikidata at Wikimedia Commons. Walang kailangang API key."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les recherches de métadonnées et de pochettes utilisent iTunes Search, MusicBrainz, Deezer, Wikidata et Wikimedia Commons sans clé. Aucune clé d’API n’est nécessaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेटाडेटा और आर्टवर्क की खोज बिना कुंजी वाले iTunes Search, MusicBrainz, Deezer, Wikidata और Wikimedia Commons का इस्तेमाल करती है। किसी API कुंजी की ज़रूरत नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencarian metadata dan sampul memakai iTunes Search, MusicBrainz, Deezer, Wikidata, dan Wikimedia Commons tanpa kunci. Tidak perlu kunci API."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le ricerche di metadati e copertine usano iTunes Search, MusicBrainz, Deezer, Wikidata e Wikimedia Commons senza chiavi. Non servono chiavi API."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メタデータとアートワークの検索には、キー不要の iTunes Search、MusicBrainz、Deezer、Wikidata、Wikimedia Commons を使います。API キーは必要ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메타데이터와 아트워크 검색에는 키가 필요 없는 iTunes Search, MusicBrainz, Deezer, Wikidata, Wikimedia Commons를 사용합니다. API 키가 필요하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoeken naar metadata en hoezen gebruikt iTunes Search, MusicBrainz, Deezer, Wikidata en Wikimedia Commons zonder sleutels. Er zijn geen API-sleutels nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyszukiwanie metadanych i okładek korzysta z iTunes Search, MusicBrainz, Deezer, Wikidanych i Wikimedia Commons bez kluczy. Klucze API nie są potrzebne."
