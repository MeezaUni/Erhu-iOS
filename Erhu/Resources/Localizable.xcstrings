        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumagamit ang paghahanap ng metadata at artwork ng walang-key na iTunes Search, MusicBrainz, Deezer, Wikidata at Wikimedia Commons. Walang kailangang API key."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les recherches de métadonnées et de pochettes utilisent iTunes Search, MusicBrainz, Deezer, Wikidata et Wikimedia Commons sans clé. Aucune clé d’API n’est nécessaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेटाडेटा और आर्टवर्क की खोज बिना कुंजी वाले iTunes Search, MusicBrainz, Deezer, Wikidata और Wikimedia Commons का इस्तेमाल करती है। किसी API कुंजी की ज़रूरत नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencarian metadata dan sampul memakai iTunes Search, MusicBrainz, Deezer, Wikidata, dan Wikimedia Commons tanpa kunci. Tidak perlu kunci API."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le ricerche di metadati e copertine usano iTunes Search, MusicBrainz, Deezer, Wikidata e Wikimedia Commons senza chiavi. Non servono chiavi API."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メタデータとアートワークの検索には、キー不要の iTunes Search、MusicBrainz、Deezer、Wikidata、Wikimedia Commons を使います。API キーは必要ありません。"
