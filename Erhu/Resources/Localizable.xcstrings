    "The compressed video did not pass playback, frame, colour or timing checks. Your original is unchanged." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يجتز الفيديو المضغوط فحوص التشغيل أو الإطارات أو الألوان أو التوقيت. لم يتغير غلافك الأصلي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কম্প্রেস করা ভিডিও প্লেব্যাক, ফ্রেম, রং বা টাইমিং যাচাইয়ে পাস করেনি। আপনার মূল কভার বদলায়নি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das komprimierte Video hat die Prüfungen für Wiedergabe, Bilder, Farbe oder Timing nicht bestanden. Dein Original bleibt unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El vídeo comprimido no superó las comprobaciones de reproducción, fotogramas, color o tiempo. El original no cambia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ویدیوی فشرده‌شده در بررسی پخش، فریم، رنگ یا زمان‌بندی رد شد. جلد اصلی شما تغییر نکرد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi pumasa ang na-compress na video sa pagsusuri ng playback, frame, kulay o timing. Hindi nagbago ang orihinal mong cover."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vidéo compressée n’a pas réussi les contrôles de lecture, d’images, de couleur ou de timing. L’original reste inchangé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कंप्रेस किया गया वीडियो प्लेबैक, फ़्रेम, रंग या टाइमिंग जाँच में पास नहीं हुआ। आपका मूल कवर नहीं बदला।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video terkompresi tidak lolos pemeriksaan pemutaran, bingkai, warna, atau waktu. Aslinya tidak berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il video compresso non ha superato i controlli di riproduzione, fotogrammi, colore o tempi. L’originale non cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圧縮した動画が再生、フレーム、色、タイミングのチェックに合格しませんでした。元のカバーは変更されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "압축된 동영상이 재생, 프레임, 색상 또는 타이밍 검사를 통과하지 못했습니다. 원본은 바뀌지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gecomprimeerde video slaagde niet voor de controles op afspelen, beelden, kleur of timing. Je origineel is ongewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skompresowane wideo nie przeszło testów odtwarzania, klatek, kolorów lub czasu. Oryginał pozostaje bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O vídeo comprimido não passou nas verificações de reprodução, quadros, cor ou tempo. O original não muda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сжатое видео не прошло проверки воспроизведения, кадров, цвета или тайминга. Оригинал не изменён."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சுருக்கிய வீடியோ இயக்கம், சட்டகம், நிறம் அல்லது நேரச் சோதனைகளில் தேறவில்லை. உங்கள் அசல் அட்டை மாறவில்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కంప్రెస్ చేసిన వీడియో ప్లేబ్యాక్, ఫ్రేమ్, రంగు లేదా సమయ తనిఖీలలో ఉత్తీర్ణం కాలేదు. మీ అసలు కవర్ మారలేదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วิดีโอที่บีบอัดไม่ผ่านการตรวจการเล่น เฟรม สี หรือจังหวะเวลา ต้นฉบับไม่ได้เปลี่ยน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıkıştırılan video oynatma, kare, renk veya zamanlama denetimlerini geçemedi. Orijinaliniz değişmedi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стиснене відео не пройшло перевірок відтворення, кадрів, кольору чи таймінгу. Оригінал не змінено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کمپریس شدہ ویڈیو پلے بیک، فریم، رنگ یا ٹائمنگ کی جانچ میں پاس نہیں ہوئی۔ آپ کا اصل کور نہیں بدلا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video đã nén không qua được kiểm tra phát, khung hình, màu hoặc thời gian. Bản gốc không thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "压缩后的视频未通过播放、帧、颜色或时间检查。原始文件未更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壓縮後的影片未透過播放、幀、顏色或時間檢查。原始檔案未更改。"
          }
        }
      }
    },
