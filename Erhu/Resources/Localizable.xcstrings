        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کاملاً اصلاح‌شده: %@؛ %lld هنوز نیاز به بررسی دارد. اصلاحات ناقص نوشته نشد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganap na naayos: %@; %lld ang kailangan pang suriin. Hindi isinulat ang mga bahagyang pag-aayos."
