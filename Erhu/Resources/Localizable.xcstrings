    "Use + to choose files, or start Wi-Fi Transfer to send music from a computer. Browse your albums, artists and playlists." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle mit + Dateien aus oder starte die WLAN-Übertragung, um Musik von einem Computer zu senden. Durchstöbere deine Alben, Interpreten und Playlists."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa + para elegir archivos o inicia la Transferencia por Wi-Fi para enviar música desde un ordenador. Explora tus álbumes, artistas y listas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez + pour choisir des fichiers, ou lancez le Transfert Wi-Fi pour envoyer de la musique depuis un ordinateur. Parcourez vos albums, artistes et playlists."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ाइलें चुनने के लिए + का इस्तेमाल करें, या कंप्यूटर से संगीत भेजने के लिए Wi-Fi ट्रांसफ़र शुरू करें। अपने एल्बम, कलाकार और प्लेलिस्ट ब्राउज़ करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan + untuk memilih file, atau mulai Transfer Wi-Fi untuk mengirim musik dari komputer. Jelajahi album, artis, dan daftar putar Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa + per scegliere i file oppure avvia Trasferimento Wi-Fi per inviare musica da un computer. Sfoglia album, artisti e playlist."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik + om bestanden te kiezen, of start Wifi-overdracht om muziek van een computer te sturen. Blader door je albums, artiesten en playlists."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj +, aby wybrać pliki, albo uruchom Przesyłanie przez Wi-Fi, aby wysłać muzykę z komputera. Przeglądaj albumy, wykonawców i playlisty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use + para escolher arquivos ou inicie a Transferência por Wi-Fi para enviar músicas de um computador. Navegue por álbuns, artistas e playlists."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите +, чтобы выбрать файлы, или запустите передачу по Wi-Fi, чтобы отправить музыку с компьютера. Просматривайте альбомы, исполнителей и плейлисты."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosya seçmek için + kullanın veya bir bilgisayardan müzik göndermek için Wi-Fi Aktarımı'nı başlatın. Albümlerinize, sanatçılarınıza ve çalma listelerinize göz atın."
          }
        }
      }
    },
