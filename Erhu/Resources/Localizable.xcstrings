    "Changes levels only while a transition set up in the Transition Studio plays" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يغيّر المستويات فقط أثناء تشغيل انتقال مُعَدّ في استوديو الانتقالات"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ট্রানজিশন স্টুডিওতে সেট করা ট্রানজিশন বাজার সময়ই কেবল লেভেল বদলায়"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändert Pegel nur, während ein im Übergangsstudio eingerichteter Übergang läuft"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia los niveles solo mientras suena una transición configurada en el Estudio de transiciones"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط هنگام پخش گذاری که در استودیوی گذار تنظیم شده، سطح‌ها را تغییر می‌دهد"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binabago lang ang level habang tumutugtog ang transition na na-set up sa Transition Studio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifie les niveaux uniquement pendant une transition configurée dans le Studio de transitions"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्तर सिर्फ़ तब बदलता है जब ट्रांज़िशन स्टूडियो में सेट किया गया ट्रांज़िशन बज रहा हो"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengubah level hanya saat transisi yang diatur di Studio Transisi diputar"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia i livelli solo mentre suona una transizione impostata nello Studio transizioni"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トランジションスタジオで設定したトランジションの再生中にのみレベルを変更します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트랜지션 스튜디오에서 설정한 트랜지션이 재생될 때만 레벨을 변경합니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wijzigt niveaus alleen tijdens een overgang die in de Overgangsstudio is ingesteld"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmienia poziomy tylko podczas przejścia ustawionego w Studiu przejść"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muda os níveis apenas enquanto toca uma transição configurada no Estúdio de transições"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняет уровни, только пока играет переход, настроенный в Студии переходов"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மாற்ற ஸ்டுடியோவில் அமைத்த மாற்றம் இயங்கும்போது மட்டும் நிலைகளை மாற்றும்"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ట్రాన్సిషన్ స్టూడియోలో సెట్ చేసిన ట్రాన్సిషన్ ప్లే అయినప్పుడు మాత్రమే స్థాయిలను మారుస్తుంది"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปลี่ยนระดับเฉพาะขณะเล่นการเปลี่ยนผ่านที่ตั้งไว้ในสตูดิโอการเปลี่ยนผ่าน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seviyeleri yalnızca Geçiş Stüdyosu’nda ayarlanan bir geçiş çalarken değiştirir"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Змінює рівні лише під час відтворення переходу, налаштованого в Студії переходів"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صرف تب سطحیں بدلتا ہے جب ٹرانزیشن اسٹوڈیو میں ترتیب دی گئی ٹرانزیشن چل رہی ہو"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ đổi mức khi đang phát một chuyển tiếp được thiết lập trong Studio chuyển tiếp"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在播放过渡工作室中设置的过渡时更改电平"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅在播放過渡工作室中設定的過渡時更改電平"
          }
        }
      }
    },
