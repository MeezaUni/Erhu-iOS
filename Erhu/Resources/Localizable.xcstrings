    "Welcome to Erhu" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Witaj w Erhu"
          }
        }
      }
    },
    "What iOS reports for the audio session. The session sample rate is what the hardware runs at now; iOS converts the app's output to it when they differ." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co iOS podaje dla sesji audio. Częstotliwość próbkowania sesji to obecna częstotliwość sprzętu; iOS przelicza do niej dźwięk aplikacji, gdy się różnią."
          }
        }
      }
    },
    "What the app's audio engine reports for the current track: the format the file is decoded to, and the format it hands to iOS after the app's processing." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co silnik dźwięku aplikacji podaje dla bieżącego utworu: format, do którego plik jest dekodowany, i format przekazywany do iOS po przetworzeniu przez aplikację."
          }
        }
      }
    },
