        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить текст. Проверьте свободное место и повторите."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பாடல் வரிகளைச் சேமிக்க முடியவில்லை. கிடைக்கும் சேமிப்பகத்தைச் சரிபார்த்து மீண்டும் முயலவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సాహిత్యాన్ని సేవ్ చేయలేకపోయాము. అందుబాటులో ఉన్న నిల్వను తనిఖీ చేసి మళ్ళీ ప్రయత్నించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
