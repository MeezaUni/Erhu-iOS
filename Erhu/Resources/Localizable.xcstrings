    "Adjust to move the view without moving either cue." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضبط لتحريك العرض دون تحريك أي نقطة إشارة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো কিউ না সরিয়ে ভিউ সরাতে সামঞ্জস্য করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändert die Ansicht, ohne einen Cue-Punkt zu verschieben."
          }
