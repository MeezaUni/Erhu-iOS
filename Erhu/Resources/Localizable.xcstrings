    "Move lyrics earlier if they arrive late, or later if they arrive too soon." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قدّم الكلمات إذا تأخرت، أو أخّرها إذا جاءت مبكرًا جدًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গানের কথা দেরিতে এলে আগে, খুব আগে এলে পরে সরান।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebe den Songtext früher, wenn er zu spät kommt, oder später, wenn er zu früh kommt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adelanta la letra si llega tarde, o retrásala si llega demasiado pronto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر متن آهنگ دیر می‌رسد آن را جلوتر و اگر زود می‌رسد عقب‌تر ببرید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilipat nang mas maaga ang lyrics kung huli ito, o mas huli kung masyadong maaga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avancez les paroles si elles arrivent en retard, ou retardez-les si elles arrivent trop tôt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बोल देर से आएँ तो पहले करें, बहुत जल्दी आएँ तो बाद में।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Majukan lirik jika datang terlambat, atau mundurkan jika datang terlalu cepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anticipa il testo se arriva in ritardo, o ritardalo se arriva troppo presto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌詞が遅れる場合は前へ、早すぎる場合は後ろへ移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가사가 늦게 나오면 앞으로, 너무 빨리 나오면 뒤로 옮기세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vervroeg de songtekst als hij te laat komt, of verlaat hem als hij te vroeg komt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń tekst wcześniej, jeśli się spóźnia, albo później, jeśli pojawia się za wcześnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiante a letra se ela chega atrasada, ou atrase se chega cedo demais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сдвиньте текст раньше, если он запаздывает, или позже, если появляется слишком рано."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பாடல் வரிகள் தாமதமாக வந்தால் முன்னதாக, மிக முன்னதாக வந்தால் பின்னதாக நகர்த்தவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సాహిత్యం ఆలస్యంగా వస్తే ముందుకు, చాలా త్వరగా వస్తే వెనక్కి జరపండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลื่อนเนื้อเพลงให้เร็วขึ้นหากมาช้า หรือช้าลงหากมาเร็วเกินไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sözler geç geliyorsa öne, çok erken geliyorsa geriye alın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посуньте текст раніше, якщо він запізнюється, або пізніше, якщо з’являється зарано."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر بول دیر سے آئیں تو پہلے کریں، اور اگر بہت جلدی آئیں تو بعد میں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dời lời sớm hơn nếu lời đến muộn, hoặc muộn hơn nếu đến quá sớm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌词来得晚就提前，来得太早就推后。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌詞來得晚就提前，來得太早就推後。"
          }
        }
      }
    },
