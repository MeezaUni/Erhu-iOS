    "Keep music playing, expand the Lock Screen cover, and check that Low Power Mode and Reduce Motion are off." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ الموسيقى قيد التشغيل، ووسّع غلاف شاشة القفل، وتحقّق من أن وضع الطاقة المنخفضة وتقليل الحركة متوقفان."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গান চালু রাখুন, লক স্ক্রিনের কভার বড় করুন, এবং লো পাওয়ার মোড ও গতি কমান বন্ধ আছে কিনা দেখুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass die Musik laufen, vergrößere das Cover auf dem Sperrbildschirm und prüfe, ob Stromsparmodus und „Bewegung reduzieren“ aus sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la música sonando, amplía la portada en la pantalla de bloqueo y comprueba que el modo de bajo consumo y Reducir movimiento estén desactivados."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موسیقی را در حال پخش نگه دارید، جلد صفحه قفل را گسترش دهید و بررسی کنید که حالت کم‌مصرف و کاهش حرکت خاموش باشند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panatilihing tumutugtog ang musika, palakihin ang cover sa Lock Screen, at tiyaking naka-off ang Low Power Mode at Bawasan ang galaw."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez la musique jouer, agrandissez la pochette sur l’écran verrouillé et vérifiez que le mode économie d’énergie et Réduire les animations sont désactivés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संगीत चलता रहने दें, लॉक स्क्रीन पर कवर बड़ा करें, और जाँचें कि लो पावर मोड और गति कम करें बंद हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biarkan musik tetap diputar, perbesar sampul di Layar Terkunci, dan pastikan Mode Daya Rendah serta Kurangi Gerakan nonaktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia suonare la musica, ingrandisci la copertina nella schermata di blocco e controlla che Risparmio energetico e Riduci movimento siano disattivati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音楽を再生したまま、ロック画面のカバーを拡大し、低電力モードと視差効果を減らすがオフになっていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음악을 계속 재생하고, 잠금 화면 커버를 펼친 다음, 저전력 모드와 동작 줄이기가 꺼져 있는지 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat de muziek spelen, vergroot de hoes op het toegangsscherm en controleer of Energiebesparingsmodus en Verminder beweging uit staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie przerywaj muzyki, powiększ okładkę na ekranie blokady i sprawdź, czy tryb niskiego zużycia energii i Ogranicz ruch są wyłączone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha a música tocando, amplie a capa na tela de bloqueio e verifique se o Modo de Pouca Energia e Reduzir Movimento estão desativados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не останавливайте музыку, разверните обложку на экране блокировки и проверьте, что режим энергосбережения и «Уменьшить движение» выключены."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இசையை இயங்க விட்டு, பூட்டுத் திரை அட்டையை விரிவாக்கி, குறைந்த ஆற்றல் பயன்முறையும் இயக்கத்தைக் குறையும் முடக்கத்தில் உள்ளனவா எனச் சரிபார்க்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సంగీతం ప్లే అవుతూ ఉంచండి, లాక్ స్క్రీన్ కవర్‌ను విస్తరించండి, మరియు లో పవర్ మోడ్, కదలికను తగ్గించండి ఆఫ్‌లో ఉన్నాయో చూడండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ให้เพลงเล่นต่อ ขยายปกบนหน้าจอล็อก และตรวจว่าโหมดพลังงานต่ำและลดการเคลื่อนไหวปิดอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Müziği çalmaya devam ettirin, kilit ekranındaki kapağı genişletin ve Düşük Güç Modu ile Hareketi Azalt’ın kapalı olduğunu kontrol edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не зупиняйте музику, розгорніть обкладинку на екрані блокування й переконайтеся, що режим енергозбереження та «Зменшення руху» вимкнено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موسیقی چلتی رکھیں، لاک اسکرین کا کور پھیلائیں، اور دیکھیں کہ لو پاور موڈ اور حرکت کم کریں بند ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ nhạc đang phát, mở rộng ảnh bìa trên Màn hình khóa, và kiểm tra Chế độ nguồn điện thấp cùng Giảm chuyển động đang tắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持音乐播放，展开锁定屏幕封面，并确认“低电量模式”和“减弱动态效果”已关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持音樂播放，展開鎖定畫面封面，並確認「低耗電模式」和「減少動態效果」已關閉。"
          }
        }
      }
    },
