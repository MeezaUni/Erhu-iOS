    "Saved into the file itself (%@). Blank fields keep the file's values." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحفظ في الملف نفسه (%@). تحتفظ الحقول الفارغة بقيم الملف."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফাইলেই সংরক্ষিত (%@)। ফাঁকা ফিল্ডে ফাইলের মান থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird in der Datei selbst gespeichert (%@). Leere Felder behalten die Werte der Datei."
