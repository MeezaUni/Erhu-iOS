        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre pochette actuelle a changé après l’ouverture de cette comparaison. Conservez l’actuelle puis relancez la recherche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह तुलना खोलने के बाद आपका मौजूदा कवर बदल गया। मौजूदा रखें, फिर दोबारा खोजें।"
