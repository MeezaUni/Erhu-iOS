    "Selected from your library. Browse first, then choose what to play." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مختارة من مكتبتك. تصفّح أولًا، ثم اختر ما تريد تشغيله."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার লাইব্রেরি থেকে বেছে নেওয়া। আগে ব্রাউজ করুন, তারপর কী চালাবেন বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus deiner Mediathek ausgewählt. Erst stöbern, dann wählen, was gespielt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elegidas de tu biblioteca. Explora primero y luego elige qué reproducir."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از کتابخانه شما انتخاب شده. ابتدا مرور کنید، سپس انتخاب کنید چه پخش شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinili mula sa library mo. Mag-browse muna, saka piliin ang ipapatugtog."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis dans votre bibliothèque. Parcourez d’abord, puis choisissez quoi écouter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी लाइब्रेरी से चुने गए। पहले देखें, फिर चुनें क्या चलाना है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dipilih dari pustaka Anda. Jelajahi dulu, lalu pilih yang ingin diputar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scelti dalla tua libreria. Prima esplora, poi scegli cosa ascoltare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリから選んでいます。まず見てから、再生するものを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관함에서 선택합니다. 먼저 둘러본 다음 재생할 항목을 고르세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gekozen uit je bibliotheek. Kijk eerst rond en kies dan wat je wilt afspelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrane z twojej biblioteki. Najpierw przeglądaj, potem wybierz, co odtworzyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhidas da sua biblioteca. Explore primeiro e depois escolha o que tocar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подобрано из вашей медиатеки. Сначала посмотрите, потом выберите, что включить."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் நூலகத்திலிருந்து தேர்ந்தெடுக்கப்பட்டது. முதலில் உலாவி, பின் எதை இயக்குவது எனத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ లైబ్రరీ నుండి ఎంచుకోబడింది. ముందు బ్రౌజ్ చేసి, తర్వాత ఏం ప్లే చేయాలో ఎంచుకోండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกจากคลังของคุณ เลือกดูก่อน แล้วเลือกสิ่งที่จะเล่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arşivinizden seçildi. Önce göz atın, sonra ne çalacağınızı seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибрано з вашої медіатеки. Спершу перегляньте, потім виберіть, що відтворити."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کی لائبریری سے منتخب۔ پہلے براؤز کریں، پھر چنیں کہ کیا چلانا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn từ thư viện của bạn. Duyệt trước, rồi chọn thứ để phát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从你的资料库中挑选。先浏览，再选择要播放的内容。"
