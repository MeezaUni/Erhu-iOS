    "Play an album with a downloaded motion cover." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل ألبومًا ذا غلاف متحرك منزَّل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডাউনলোড করা মোশন কভারসহ একটি অ্যালবাম চালান।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiele ein Album mit heruntergeladenem animiertem Cover ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce un álbum con una portada animada descargada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آلبومی با جلد متحرک بارگیری‌شده پخش کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag-play ng album na may na-download na motion cover."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez un album avec une pochette animée téléchargée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डाउनलोड किए गए मोशन कवर वाला कोई एल्बम चलाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putar album dengan sampul bergerak yang sudah diunduh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduci un album con una copertina animata scaricata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モーションカバーをダウンロード済みのアルバムを再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모션 커버를 다운로드한 앨범을 재생하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speel een album af met een gedownloade bewegende hoes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwórz album z pobraną animowaną okładką."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque um álbum com capa animada baixada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите альбом с загруженной анимированной обложкой."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பதிவிறக்கிய அசைவு அட்டையுடன் ஒரு ஆல்பத்தை இயக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "డౌన్‌లోడ్ చేసిన మోషన్ కవర్ ఉన్న ఆల్బమ్‌ను ప్లే చేయండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เล่นอัลบั้มที่ดาวน์โหลดปกเคลื่อนไหวแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirilmiş hareketli kapağı olan bir albüm çalın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відтворіть альбом із завантаженою анімованою обкладинкою."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ڈاؤن لوڈ شدہ متحرک کور والا البم چلائیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phát một album có ảnh bìa động đã tải."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放一张已下载动态封面的专辑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放一張已下載動態封面的專輯。"
          }
        }
      }
    },
